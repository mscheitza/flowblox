<UserControl x:Class="FlowBlox.UICore.Views.RuntimeViewControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
             xmlns:resources="clr-namespace:FlowBlox.UICore.Resources"
             xmlns:viewModels="clr-namespace:FlowBlox.UICore.ViewModels"
             mc:Ignorable="d"
             d:DesignHeight="545"
             d:DesignWidth="976">
    <UserControl.DataContext>
        <viewModels:RuntimeViewModel />
    </UserControl.DataContext>

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/FlowBlox.UICore;component/Views/Styles/FlowBloxCustomStyles.xaml" />
                <ResourceDictionary Source="/FlowBlox.UICore;component/Views/Styles/HostedControlStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <Style x:Key="RuntimeViewToolbarButtonStyle" TargetType="{x:Type Button}">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderBrush" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Foreground" Value="#FFE5E7EB" />
                <Setter Property="Padding" Value="8,2" />
                <Setter Property="Margin" Value="0,0,5,0" />
                <Setter Property="MinHeight" Value="22" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type Button}">
                            <Border Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#FF585858" />
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter Property="Background" Value="#FF3F3F3F" />
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter Property="Foreground" Value="#FF8A8F98" />
                                    <Setter Property="Cursor" Value="Arrow" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="RuntimeViewToolbarIconStyle"
                   TargetType="{x:Type iconPacks:PackIconMaterial}"
                   BasedOn="{StaticResource FlowBlox.ToolbarIconBase}">
                <Setter Property="Margin" Value="0,0,5,0" />
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="Foreground" Value="#FF8FB7E8" />
                <Style.Triggers>
                    <DataTrigger Binding="{Binding IsEnabled, RelativeSource={RelativeSource AncestorType={x:Type Button}}}" Value="False">
                        <Setter Property="Foreground" Value="#FF8A8F98" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>

            <Style x:Key="RuntimeViewToolbarIconStyle.Neutral"
                   TargetType="{x:Type iconPacks:PackIconMaterial}"
                   BasedOn="{StaticResource RuntimeViewToolbarIconStyle}">
                <Setter Property="Foreground" Value="#FFCBD5E1" />
            </Style>

            <Style x:Key="RuntimeViewToolbarIconStyle.Clear"
                   TargetType="{x:Type iconPacks:PackIconMaterial}"
                   BasedOn="{StaticResource RuntimeViewToolbarIconStyle}">
                <Setter Property="Foreground" Value="#FFF1A7A7" />
            </Style>

            <Style x:Key="RuntimeViewToolbarIconStyle.Refresh"
                   TargetType="{x:Type iconPacks:PackIconMaterial}"
                   BasedOn="{StaticResource RuntimeViewToolbarIconStyle}">
                <Setter Property="Foreground" Value="#FF9FC5F8" />
            </Style>

            <Style x:Key="RuntimeViewToolbarIconStyle.Success"
                   TargetType="{x:Type iconPacks:PackIconMaterial}"
                   BasedOn="{StaticResource RuntimeViewToolbarIconStyle}">
                <Setter Property="Foreground" Value="#FF7ED995" />
            </Style>

            <Style x:Key="RuntimeViewToolbarIconStyle.Warning"
                   TargetType="{x:Type iconPacks:PackIconMaterial}"
                   BasedOn="{StaticResource RuntimeViewToolbarIconStyle}">
                <Setter Property="Foreground" Value="#FFF3C96B" />
            </Style>

            <Style x:Key="RuntimeViewToolbarIconStyle.Danger"
                   TargetType="{x:Type iconPacks:PackIconMaterial}"
                   BasedOn="{StaticResource RuntimeViewToolbarIconStyle}">
                <Setter Property="Foreground" Value="#FFF08A8A" />
            </Style>

            <Style x:Key="RuntimeViewToolbarIconStyle.Folder"
                   TargetType="{x:Type iconPacks:PackIconMaterial}"
                   BasedOn="{StaticResource RuntimeViewToolbarIconStyle}">
                <Setter Property="Foreground" Value="#FFE7C26F" />
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid Background="#FF2E2E2E">
        <Grid.RowDefinitions>
            <RowDefinition Height="25" />
            <RowDefinition Height="*" />
            <RowDefinition Height="29" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#FF464646">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Command="{Binding OpenLogFileCommand}" Style="{StaticResource RuntimeViewToolbarButtonStyle}">
                    <StackPanel Orientation="Horizontal">
                        <iconPacks:PackIconMaterial Kind="FileDocumentOutline" Style="{StaticResource RuntimeViewToolbarIconStyle}" />
                        <TextBlock Text="{x:Static resources:RuntimeView.Button_OpenLogFile}" />
                    </StackPanel>
                </Button>
                <Button Command="{Binding ClearCommand, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                        Style="{StaticResource RuntimeViewToolbarButtonStyle}">
                    <StackPanel Orientation="Horizontal">
                        <iconPacks:PackIconMaterial Kind="Broom" Style="{StaticResource RuntimeViewToolbarIconStyle.Clear}" />
                        <TextBlock Text="{x:Static resources:RuntimeView.Button_ClearOutput}" />
                    </StackPanel>
                </Button>
                <Button Command="{Binding RefreshCommand}" Style="{StaticResource RuntimeViewToolbarButtonStyle}">
                    <StackPanel Orientation="Horizontal">
                        <iconPacks:PackIconMaterial Kind="Refresh" Style="{StaticResource RuntimeViewToolbarIconStyle.Refresh}" />
                        <TextBlock Text="{x:Static resources:RuntimeView.Button_Refresh}" />
                    </StackPanel>
                </Button>
                <Separator Width="1" Margin="4,4" Background="#FF717171" />
                <Button Command="{Binding ContinueCommand}" Style="{StaticResource RuntimeViewToolbarButtonStyle}">
                    <StackPanel Orientation="Horizontal">
                        <iconPacks:PackIconMaterial Kind="PlayCircleOutline" Style="{StaticResource RuntimeViewToolbarIconStyle.Success}" />
                        <TextBlock Text="{x:Static resources:RuntimeView.Button_Continue}" />
                    </StackPanel>
                </Button>
                <Button Command="{Binding PauseCommand}" Style="{StaticResource RuntimeViewToolbarButtonStyle}">
                    <StackPanel Orientation="Horizontal">
                        <iconPacks:PackIconMaterial Kind="PauseCircleOutline" Style="{StaticResource RuntimeViewToolbarIconStyle.Warning}" />
                        <TextBlock Text="{x:Static resources:RuntimeView.Button_Pause}" />
                    </StackPanel>
                </Button>
                <Button Command="{Binding StopCommand}" Style="{StaticResource RuntimeViewToolbarButtonStyle}">
                    <StackPanel Orientation="Horizontal">
                        <iconPacks:PackIconMaterial Kind="StopCircleOutline" Style="{StaticResource RuntimeViewToolbarIconStyle.Danger}" />
                        <TextBlock Text="{x:Static resources:RuntimeView.Button_StopExecution}" />
                    </StackPanel>
                </Button>
                <Separator Width="1" Margin="4,4" Background="#FF717171" />
                <Button Command="{Binding OpenExportDirectoryCommand}" Style="{StaticResource RuntimeViewToolbarButtonStyle}">
                    <StackPanel Orientation="Horizontal">
                        <iconPacks:PackIconMaterial Kind="FolderOpenOutline" Style="{StaticResource RuntimeViewToolbarIconStyle.Folder}" />
                        <TextBlock Text="{x:Static resources:RuntimeView.Button_ExportDirectory}" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Border>

        <RichTextBox x:Name="LogTextBox"
                     Grid.Row="1"
                     Background="#FF2E2E2E"
                     BorderThickness="0"
                     Foreground="White"
                     FontFamily="JetBrains Mono"
                     FontSize="11"
                     IsReadOnly="True"
                     AcceptsTab="False"
                     IsDocumentEnabled="False"
                     VerticalScrollBarVisibility="Visible"
                     HorizontalScrollBarVisibility="Auto"
                     PreviewKeyDown="LogTextBox_PreviewKeyDown">
            <FlowDocument PagePadding="0" LineHeight="14">
                <Paragraph Margin="0" />
            </FlowDocument>
        </RichTextBox>

        <Border Grid.Row="2" Background="SteelBlue">
            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        Margin="0,0,4,0">
                <CheckBox Content="{x:Static resources:RuntimeView.CheckBox_StopOnError}"
                          IsChecked="{Binding StopOnError, Mode=TwoWay}"
                          Foreground="White"
                          FontFamily="Calibri"
                          FontSize="11"
                          Margin="4,0" />
                <CheckBox Content="{x:Static resources:RuntimeView.CheckBox_StopOnWarning}"
                          IsChecked="{Binding StopOnWarning, Mode=TwoWay}"
                          Foreground="White"
                          FontFamily="Calibri"
                          FontSize="11"
                          Margin="4,0" />
                <CheckBox Content="{x:Static resources:RuntimeView.CheckBox_StepwiseExecution}"
                          IsChecked="{Binding StepwiseExecution, Mode=TwoWay}"
                          Foreground="White"
                          FontFamily="Calibri"
                          FontSize="11"
                          Margin="4,0" />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
