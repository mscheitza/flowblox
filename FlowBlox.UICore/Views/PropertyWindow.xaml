<mah:MetroWindow
    x:Class="FlowBlox.UICore.Views.PropertyWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:views="clr-namespace:FlowBlox.UICore.Views"
    xmlns:viewModel="clr-namespace:FlowBlox.UICore.ViewModels.PropertyView"
    xmlns:converters="clr-namespace:FlowBlox.UICore.Converters"
    xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
    xmlns:resources="clr-namespace:FlowBlox.UICore.Resources"
    xmlns:utilities="clr-namespace:FlowBlox.UICore.Utilities"
    mc:Ignorable="d"
    Title="{Binding HeaderTitle}"
    Height="600"
    Width="800">

    <Window.DataContext>
        <viewModel:PropertyWindowViewModel />
    </Window.DataContext>

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/FlowBlox.UICore;component/Views/MahAppMetroResources.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
            <converters:BoolToInverseVisibilityConverter x:Key="BoolToInverseVisibilityConverter"/>
            <converters:NullToVisibilityConverter x:Key="NullToVisibilityConverter"/>
            <converters:CountToVisibilityConverter x:Key="CountToVisibilityConverter"/>
            <Style x:Key="SpecialExplanationLinkButtonStyle" TargetType="Button">
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="BorderBrush" Value="Transparent"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="Padding" Value="0"/>
                <Setter Property="HorizontalContentAlignment" Value="Left"/>
                <Setter Property="Cursor" Value="Arrow"/>
                <Setter Property="Foreground" Value="#3A6EA5"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Root"
                                    Background="{TemplateBinding Background}"
                                    CornerRadius="3"
                                    Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                  VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Foreground" Value="#5B8FC7"/>
                                    <Setter Property="Cursor" Value="Hand"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <DockPanel>

        <!-- Header -->
        <Border Background="#FFEEEEEE" DockPanel.Dock="Top" Height="50" Padding="8">
            <StackPanel Orientation="Horizontal">
                <Image Source="{Binding HeaderIcon}" Width="32" Height="32" Margin="0,0,10,0"/>
                <TextBlock Text="{Binding HeaderTitle}" FontWeight="Bold" VerticalAlignment="Center" />
            </StackPanel>
        </Border>

        <!-- Description -->
        <Border Background="#EDF3F9"
        DockPanel.Dock="Top"
        Padding="12"
        CornerRadius="4"
        Visibility="{Binding HeaderDescription, Converter={StaticResource NullToVisibilityConverter}}">
            <TextBlock Text="{Binding HeaderDescription}"
               FontWeight="UltraLight"
               Foreground="DarkSlateGray"
               TextWrapping="Wrap"
               TextTrimming="CharacterEllipsis" />
        </Border>

        <!-- Special explanations -->
        <Expander DockPanel.Dock="Top"
                  Margin="0,8,0,0"
                  Header="Zusätzliche Informationen"
                  IsExpanded="False"
                  Visibility="{Binding SpecialExplanations.Count, Converter={StaticResource CountToVisibilityConverter}}">
            <Border Background="#F8FBFF" Padding="10" BorderBrush="#D8E1ED" BorderThickness="1" CornerRadius="4">
                <ItemsControl ItemsSource="{Binding SpecialExplanations}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <DockPanel Margin="0,0,0,6">
                                <iconPacks:PackIconMaterial Kind="{Binding IconKind}"
                                                            Width="16"
                                                            Height="16"
                                                            Margin="0,0,8,0"
                                                            VerticalAlignment="Top"
                                                            Foreground="{Binding IconForeground}"/>
                                <StackPanel Visibility="{Binding HasContinuationMarker, Converter={StaticResource BoolToVisibilityConverter}}">
                                    <TextBlock utilities:TextBlockLinkHelper.FormattedText="{Binding DisplayText, Mode=OneWay}"
                                               TextWrapping="Wrap"
                                               Foreground="DarkSlateGray"/>
                                    <Button Command="{Binding OpenExplanationCommand}"
                                            Style="{StaticResource SpecialExplanationLinkButtonStyle}"
                                            ToolTip="Open details"
                                            HorizontalAlignment="Left"
                                            Margin="0,3,0,0">
                                        <TextBlock Text="{x:Static resources:PropertyWindow.ReadMore}"
                                                   FontSize="11"
                                                   Opacity="0.9"
                                                   Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                                    </Button>
                                </StackPanel>
                                <TextBlock utilities:TextBlockLinkHelper.FormattedText="{Binding DisplayText, Mode=OneWay}"
                                           TextWrapping="Wrap"
                                           Foreground="DarkSlateGray"
                                           Visibility="{Binding HasContinuationMarker, Converter={StaticResource BoolToInverseVisibilityConverter}}"/>
                            </DockPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Border>
        </Expander>

        <!-- Operations -->
        <Border Background="#DDE7F3"
            DockPanel.Dock="Top"
            BorderBrush="#CCC"
            BorderThickness="0,1,0,1"
            Padding="6,4,6,4"
            Margin="0,0,0,0">
            <ItemsControl ItemsSource="{Binding UIActions}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Button Command="{Binding Command}"
                            IsEnabled="{Binding IsEnabled}"
                            ToolTip="{Binding DisplayName}"
                            Margin="3,0"
                            Padding="6,3"
                            MinWidth="80"
                            Style="{StaticResource {x:Static ToolBar.ButtonStyleKey}}">
                            <StackPanel Orientation="Horizontal">
                                <Image Source="{Binding Icon}"
                                   Width="16"
                                   Height="16"
                                   VerticalAlignment="Center"
                                   Margin="0,0,5,0">
                                </Image>
                                <TextBlock Text="{Binding DisplayName}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Border>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" DockPanel.Dock="Bottom" Margin="10">

            <!-- Back -->
            <Button Margin="5" Command="{Binding CancelCommand}" IsCancel="True">
                <StackPanel Orientation="Horizontal">
                    <iconPacks:PackIconMaterial Kind="ArrowLeft"
                                        Width="14"
                                        Height="14"
                                        VerticalAlignment="Center"
                                        Margin="0,0,5,0"/>
                    <TextBlock Text="{x:Static resources:PropertyWindow.Back}" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>

            <!-- SaveWithoutVerification -->
            <Button Margin="5"
                Command="{Binding SaveWithoutVerificationCommand}"
                Visibility="{Binding DisplaySaveButton, Converter={StaticResource BoolToVisibilityConverter}}">
                <StackPanel Orientation="Horizontal">
                    <iconPacks:PackIconMaterial Kind="ContentSaveEdit"
                                        Width="14"
                                        Height="14"
                                        VerticalAlignment="Center"
                                        Margin="0,0,5,0"/>
                    <TextBlock Text="{x:Static resources:PropertyWindow.SaveWithoutVerification}" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>

            <!-- Save -->
            <Button Margin="5"
                Command="{Binding SaveCommand}"
                Visibility="{Binding DisplaySaveButton, Converter={StaticResource BoolToVisibilityConverter}}"
                IsDefault="True">
                <StackPanel Orientation="Horizontal">
                    <iconPacks:PackIconMaterial Kind="ContentSave"
                                        Width="14"
                                        Height="14"
                                        VerticalAlignment="Center"
                                        Margin="0,0,5,0"/>
                    <TextBlock Text="{x:Static resources:PropertyWindow.Save}" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
        </StackPanel>

        <!-- PropertyView Embedding -->
        <views:PropertyView DataContext="{Binding PropertyViewModel}" />

    </DockPanel>
</mah:MetroWindow>
