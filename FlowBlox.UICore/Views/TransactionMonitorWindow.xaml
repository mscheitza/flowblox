<mah:MetroWindow
    x:Class="FlowBlox.UICore.Views.TransactionMonitorWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
    xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
    xmlns:resources="clr-namespace:FlowBlox.UICore.Resources"
    xmlns:converters="clr-namespace:FlowBlox.UICore.Converters"
    Title="{x:Static resources:TransactionMonitorWindow.Title}"
    Height="600"
    Width="1050"
    MinHeight="380"
    MinWidth="760"
    WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/FlowBlox.UICore;component/Views/MahAppMetroResources.xaml" />
                <ResourceDictionary Source="/FlowBlox.UICore;component/Views/Styles/FlowBloxCustomStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />
        </ResourceDictionary>
    </Window.Resources>

    <DockPanel Margin="10">
        <Border DockPanel.Dock="Top"
                Height="54"
                Padding="10"
                Background="#FFEEEEEE">
            <StackPanel Orientation="Horizontal">
                <iconPacks:PackIconMaterial Kind="SwapHorizontal"
                                            Width="30"
                                            Height="30"
                                            Margin="0,0,10,0"
                                            Foreground="#2F6DB3"
                                            VerticalAlignment="Center" />
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="{x:Static resources:TransactionMonitorWindow.Header}"
                               FontSize="16"
                               FontWeight="Bold" />
                    <TextBlock Text="{x:Static resources:TransactionMonitorWindow.ShortcutHint}"
                               Foreground="#65737E"
                               FontSize="11" />
                </StackPanel>
            </StackPanel>
        </Border>

        <Grid DockPanel.Dock="Top" Margin="0,10,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="190" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="#EDF3F9" CornerRadius="4" Padding="12">
                <StackPanel>
                    <TextBlock Text="{x:Static resources:TransactionMonitorWindow.ActiveTransactions}"
                               Foreground="#65737E" />
                    <TextBlock Text="{Binding ActiveTransactionCount}"
                               FontSize="24"
                               FontWeight="SemiBold"
                               Foreground="#2F6DB3" />
                </StackPanel>
            </Border>

            <Border Grid.Column="2" Background="#EDF3F9" CornerRadius="4" Padding="12">
                <StackPanel>
                    <TextBlock Text="{x:Static resources:TransactionMonitorWindow.CurrentTransaction}"
                               Foreground="#65737E" />
                    <TextBlock Text="{Binding CurrentTransaction}"
                               FontSize="14"
                               FontWeight="SemiBold"
                               TextTrimming="CharacterEllipsis" />
                </StackPanel>
            </Border>
        </Grid>

        <Border DockPanel.Dock="Top"
                Background="#FFF8E1"
                BorderBrush="#FFE0B2"
                BorderThickness="1"
                CornerRadius="4"
                Padding="10"
                Margin="0,0,0,10">
            <TextBlock Text="{x:Static resources:TransactionMonitorWindow.RootExplanation}"
                       Foreground="#6D5A21"
                       TextWrapping="Wrap" />
        </Border>

        <DataGrid ItemsSource="{Binding Transactions}"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  CanUserAddRows="False"
                  CanUserDeleteRows="False"
                  GridLinesVisibility="Horizontal"
                  HeadersVisibility="Column"
                  AlternatingRowBackground="#F7F9FB"
                  SelectionMode="Single">
            <DataGrid.ContextMenu>
                <ContextMenu>
                    <MenuItem Header="{x:Static resources:TransactionMonitorWindow.ContextMenu_ClearInactiveTransactions}"
                              Command="{Binding PlacementTarget.DataContext.ClearInactiveTransactionsCommand, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type ContextMenu}}}">
                        <MenuItem.Icon>
                            <iconPacks:PackIconMaterial Kind="Broom"
                                                        Width="16"
                                                        Height="16"
                                                        Foreground="#C94F4F" />
                        </MenuItem.Icon>
                    </MenuItem>
                </ContextMenu>
            </DataGrid.ContextMenu>
            <DataGrid.RowStyle>
                <Style TargetType="DataGridRow">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                            <Setter Property="Background" Value="#DCEAF7" />
                            <Setter Property="FontWeight" Value="SemiBold" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </DataGrid.RowStyle>
            <DataGrid.Columns>
                <DataGridTemplateColumn Width="38">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <iconPacks:PackIconMaterial Kind="ArrowRightBold"
                                                        Width="18"
                                                        Height="18"
                                                        Foreground="#2F6DB3"
                                                        Visibility="{Binding IsCurrent, Converter={StaticResource BoolToVisibilityConverter}}" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="#" Binding="{Binding Id}" Width="55" />
                <DataGridTextColumn Header="{x:Static resources:TransactionMonitorWindow.Column_Target}" Binding="{Binding TargetType}" Width="2*" />
                <DataGridTextColumn Header="{x:Static resources:TransactionMonitorWindow.Column_Registry}" Binding="{Binding RegistryType}" Width="2*" />
                <DataGridTextColumn Header="{x:Static resources:TransactionMonitorWindow.Column_Mode}" Binding="{Binding Mode}" Width="95" />
                <DataGridTextColumn Header="{x:Static resources:TransactionMonitorWindow.Column_Depth}" Binding="{Binding Depth}" Width="65" />
                <DataGridTextColumn Header="{x:Static resources:TransactionMonitorWindow.Column_Opened}" Binding="{Binding OpenedAt}" Width="110" />
                <DataGridTextColumn Header="{x:Static resources:TransactionMonitorWindow.Column_Closed}" Binding="{Binding ClosedAt}" Width="110" />
                <DataGridTextColumn Header="{x:Static resources:TransactionMonitorWindow.Column_State}" Binding="{Binding State}" Width="105" />
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
</mah:MetroWindow>
