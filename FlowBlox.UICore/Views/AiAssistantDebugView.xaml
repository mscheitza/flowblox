<mah:MetroWindow x:Class="FlowBlox.UICore.Views.AiAssistantDebugView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
    xmlns:icons="http://metro.mahapps.com/winfx/xaml/iconpacks"
    xmlns:avalonedit="http://icsharpcode.net/sharpdevelop/avalonedit"
    xmlns:resources="clr-namespace:FlowBlox.UICore.Resources"
    Title="{Binding Title}" Height="800" Width="1280" MinHeight="420" MinWidth="760"
    WindowStartupLocation="CenterOwner">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/FlowBlox.UICore;component/Views/MahAppMetroResources.xaml" />
                <ResourceDictionary Source="/FlowBlox.UICore;component/Views/Styles/FlowBloxCustomStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <BooleanToVisibilityConverter x:Key="VisibleIfTrue" />
            <Style x:Key="RuntimeButton" TargetType="Button"
                   BasedOn="{StaticResource FlowBlox.WindowActionButton}">
                <Setter Property="MinWidth" Value="0" />
                <Setter Property="MinHeight" Value="0" />
                <Setter Property="Height" Value="28" />
                <Setter Property="Padding" Value="8,3" />
                <Setter Property="Margin" Value="4,0,0,0" />
                <Setter Property="FontSize" Value="12" />
                <Setter Property="ToolTipService.ShowOnDisabled" Value="True" />
                <Style.Triggers>
                    <Trigger Property="IsEnabled" Value="False">
                        <Setter Property="Foreground" Value="{StaticResource FlowBlox.Icon.DisabledBrush}" />
                        <Setter Property="Background" Value="#FFF3F4F6" />
                        <Setter Property="BorderBrush" Value="#FFD1D5DB" />
                    </Trigger>
                </Style.Triggers>
            </Style>
            <Style x:Key="RuntimeContinueButton" TargetType="Button" BasedOn="{StaticResource RuntimeButton}">
                <Setter Property="Foreground" Value="#FF247145" />
                <Setter Property="Background" Value="#FFEAF5EE" />
                <Setter Property="BorderBrush" Value="#FFB8D8C4" />
            </Style>
            <Style x:Key="RuntimePauseButton" TargetType="Button" BasedOn="{StaticResource RuntimeButton}">
                <Setter Property="Foreground" Value="#FF946000" />
                <Setter Property="Background" Value="#FFFFF6DF" />
                <Setter Property="BorderBrush" Value="#FFE5CF98" />
            </Style>
            <Style x:Key="RuntimeStopButton" TargetType="Button" BasedOn="{StaticResource RuntimeButton}">
                <Setter Property="Foreground" Value="#FFB33434" />
                <Setter Property="Background" Value="#FFFBECEC" />
                <Setter Property="BorderBrush" Value="#FFE4BABA" />
            </Style>
            <Style x:Key="RuntimeIcon" TargetType="icons:PackIconMaterial"
                   BasedOn="{StaticResource FlowBlox.ToolbarIconBase}">
                <Setter Property="Width" Value="13" />
                <Setter Property="Height" Value="13" />
                <Setter Property="Margin" Value="0,0,4,0" />
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="Foreground" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
            </Style>
            <Style x:Key="CardItem" TargetType="ListBoxItem">
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="Margin" Value="0,0,0,8" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ListBoxItem">
                            <Border x:Name="Card" Padding="12" CornerRadius="6" Background="#FFF7F9FB"
                                    BorderBrush="#FFD8E0E8" BorderThickness="1">
                                <ContentPresenter />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter TargetName="Card" Property="Background" Value="#FFE8F1FC" />
                                    <Setter TargetName="Card" Property="BorderBrush" Value="#FF2F6DB3" />
                                </Trigger>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Card" Property="BorderBrush" Value="#FF2F6DB3" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </Window.Resources>
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Border Background="#FFEDF3F9" Padding="12" CornerRadius="6" Margin="0,0,0,12">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding Title}" FontSize="18" FontWeight="SemiBold"
                           TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,12,0" />
                <ToolBar Grid.Column="1" Background="Transparent" BorderThickness="0" Padding="0"
                         ToolBarTray.IsLocked="True" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <TextBlock Text="{Binding RuntimeLabel}" VerticalAlignment="Center" Margin="0,0,6,0" />
                    <Button Command="{Binding Runtime.ContinueCommand}" Style="{StaticResource RuntimeContinueButton}"
                            ToolTip="{Binding Runtime.ContinueTooltip}">
                        <StackPanel Orientation="Horizontal">
                            <icons:PackIconMaterial Kind="Play" Style="{StaticResource RuntimeIcon}" />
                            <TextBlock Text="{Binding Runtime.ContinueButtonText}" />
                        </StackPanel>
                    </Button>
                    <Button Command="{Binding Runtime.PauseCommand}" Style="{StaticResource RuntimePauseButton}"
                            ToolTip="{x:Static resources:AiAssistantChatView.Tooltip_Pause}">
                        <StackPanel Orientation="Horizontal">
                            <icons:PackIconMaterial Kind="Pause" Style="{StaticResource RuntimeIcon}" />
                            <TextBlock Text="{Binding Runtime.PauseButtonText}" />
                        </StackPanel>
                    </Button>
                    <Button Command="{Binding Runtime.StopCommand}" Style="{StaticResource RuntimeStopButton}"
                            ToolTip="{x:Static resources:AiAssistantChatView.Tooltip_Stop}">
                        <StackPanel Orientation="Horizontal">
                            <icons:PackIconMaterial Kind="Stop" Style="{StaticResource RuntimeIcon}" />
                            <TextBlock Text="{x:Static resources:AiAssistantChatView.Button_Stop}" />
                        </StackPanel>
                    </Button>
                </ToolBar>
                <TextBlock Grid.Row="1" Grid.ColumnSpan="2" Text="{Binding ContextStatistics}"
                           Foreground="#FF65737E" TextWrapping="Wrap" Margin="0,4,0,0" />
            </Grid>
        </Border>
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="0.7*" MinWidth="160" />
                <ColumnDefinition Width="8" />
                <ColumnDefinition Width="1.1*" MinWidth="210" />
                <ColumnDefinition Width="8" />
                <ColumnDefinition Width="1.8*" MinWidth="260" />
            </Grid.ColumnDefinitions>
            <ListBox ItemsSource="{Binding Topics}" SelectedItem="{Binding SelectedTopic}" BorderThickness="0"
                     Background="Transparent" ItemContainerStyle="{StaticResource CardItem}"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel>
                            <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap" />
                            <TextBlock Text="{Binding Description}" TextWrapping="Wrap" Foreground="#FF65737E" Margin="0,6,0,0" />
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
            <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Center" Background="#FFE2E6EA" />
            <Grid Grid.Column="2">
                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                <TextBlock Text="{Binding Statistics}" TextWrapping="Wrap" Foreground="#FF65737E" Margin="2,0,2,10" />
                <ListBox Grid.Row="1" ItemsSource="{Binding Cards}" SelectedItem="{Binding SelectedCard}"
                         ItemContainerStyle="{StaticResource CardItem}" BorderThickness="0" Background="Transparent"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel>
                                <DockPanel LastChildFill="True">
                                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Margin="8,0,0,0">
                                        <icons:PackIconMaterial Kind="Pin" Width="14" Height="14" Margin="0,0,6,0"
                                            Visibility="{Binding IsPinned, Converter={StaticResource VisibleIfTrue}}" ToolTip="{Binding PinTooltip}" />
                                        <TextBlock Text="{Binding Type}" FontSize="10" Foreground="#FF2F6DB3" />
                                    </StackPanel>
                                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                </DockPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                    <icons:PackIconMaterial Kind="{Binding Icon}" Width="13" Height="13" Margin="0,0,5,0" ToolTip="{Binding Status}" />
                                    <TextBlock Text="{Binding Status}" FontSize="11" Foreground="#FF65737E" />
                                </StackPanel>
                                <TextBlock Text="{Binding Preview}" TextWrapping="Wrap" Margin="0,8,0,0" />
                                <TextBlock Text="{Binding ResponsePreview}" TextWrapping="Wrap" Margin="0,8,0,0"
                                           Visibility="{Binding HasResponse, Converter={StaticResource VisibleIfTrue}}" />
                                <TextBlock Text="{Binding TokensText}" FontSize="11" Foreground="#FF65737E" Margin="0,8,0,0" />
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                <TextBlock Grid.Row="1" Text="{Binding EmptyText}" TextWrapping="Wrap" Margin="12"
                           Visibility="{Binding IsEmpty, Converter={StaticResource VisibleIfTrue}}" IsHitTestVisible="False" />
            </Grid>
            <GridSplitter Grid.Column="3" Width="5" HorizontalAlignment="Center" Background="#FFE2E6EA" />
            <Grid Grid.Column="4">
                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                <DockPanel Margin="6,0,0,8">
                    <TextBlock DockPanel.Dock="Right" Text="{Binding SelectedCard.TokensText}" Foreground="#FF65737E" Margin="8,0,0,0" />
                    <TextBlock Text="{Binding SelectedCard.Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                </DockPanel>
                <Grid Grid.Row="1" DataContext="{Binding Editor}">
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                    <ToolBar Padding="4">
                        <Button Command="ApplicationCommands.Copy" CommandTarget="{Binding ElementName=Editor}"
                                ToolTip="{x:Static resources:DisplayContentView.Tooltip_CopyToClipboard}">
                            <icons:PackIconMaterial Kind="ContentCopy" Width="16" Height="16" />
                        </Button>
                        <TextBlock Text="{x:Static resources:EditContentView.Label_Syntax}" VerticalAlignment="Center" Margin="8,0,6,0" />
                        <ComboBox ItemsSource="{Binding AvailableHighlightingNames}" SelectedItem="{Binding SelectedHighlightingName}"
                                  MinWidth="130" ToolTip="{x:Static resources:EditContentView.Combo_Syntax_Tooltip}" />
                    </ToolBar>
                    <avalonedit:TextEditor x:Name="Editor" Grid.Row="1" Document="{Binding Document}"
                        IsReadOnly="True" FontFamily="JetBrains Mono" FontSize="12" ShowLineNumbers="True"
                        HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
                        SyntaxHighlighting="{Binding SelectedHighlightingDefinition}" />
                </Grid>
            </Grid>
        </Grid>
    </Grid>
</mah:MetroWindow>
