<UserControl x:Class="FlowBlox.UICore.Views.PropertyWindowFooter"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
             xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
             xmlns:converters="clr-namespace:FlowBlox.UICore.Converters"
             xmlns:resources="clr-namespace:FlowBlox.UICore.Resources"
             mc:Ignorable="d"
             Focusable="False">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/FlowBlox.UICore;component/Views/MahAppMetroResources.xaml" />
                <ResourceDictionary Source="/FlowBlox.UICore;component/Views/Styles/FlowBloxCustomStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />
            <converters:BoolToInverseVisibilityConverter x:Key="BoolToInverseVisibilityConverter" />
            <DataTemplate x:Key="CommitActionTemplate">
                <StackPanel Orientation="Horizontal">
                    <iconPacks:PackIconMaterial Kind="{Binding IconKind}"
                                                Width="14"
                                                Height="14"
                                                Margin="0,0,8,0"
                                                VerticalAlignment="Center"
                                                Foreground="{Binding IconColor}" />
                    <TextBlock Text="{Binding DisplayName}"
                               VerticalAlignment="Center" />
                </StackPanel>
            </DataTemplate>
        </ResourceDictionary>
    </UserControl.Resources>

    <StackPanel Orientation="Horizontal"
                HorizontalAlignment="Right"
                Margin="10">
        <Button Content="{x:Static resources:PropertyWindow.Back}"
                Command="{Binding CancelCommand}"
                IsCancel="True"
                Style="{StaticResource FlowBlox.WindowActionButton.Back}" />

        <Grid Visibility="{Binding DisplaySaveButton, Converter={StaticResource BoolToVisibilityConverter}}">
            <StackPanel Orientation="Horizontal"
                        Visibility="{Binding EnableApplySplitButton, Converter={StaticResource BoolToInverseVisibilityConverter}}">
                <Button Command="{Binding ApplyWithoutVerificationCommand}"
                        mah:ControlsHelper.ContentCharacterCasing="Normal"
                        Style="{StaticResource FlowBlox.WindowActionButton}">
                    <StackPanel Orientation="Horizontal">
                        <iconPacks:PackIconMaterial Kind="ShieldOffOutline"
                                                    Width="14"
                                                    Height="14"
                                                    Margin="0,0,8,0"
                                                    VerticalAlignment="Center"
                                                    Foreground="#D97706" />
                        <TextBlock Text="{x:Static resources:PropertyWindow.ApplyWithoutVerification}"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <Button Content="{x:Static resources:PropertyWindow.Apply}"
                        Command="{Binding ApplyCommand}"
                        mah:ControlsHelper.ContentCharacterCasing="Normal"
                        Style="{StaticResource FlowBlox.WindowActionButton.Apply}" />
            </StackPanel>

            <mah:SplitButton ItemsSource="{Binding ApplyButtonActions}"
                             SelectedItem="{Binding SelectedApplyButtonAction, Mode=TwoWay}"
                             Command="{Binding SelectedApplyButtonAction.Command}"
                             ItemTemplate="{StaticResource CommitActionTemplate}"
                             Style="{StaticResource FlowBlox.WindowActionSplitButton}"
                             Visibility="{Binding EnableApplySplitButton, Converter={StaticResource BoolToVisibilityConverter}}"
                             MinWidth="138"
                             Height="32"
                             Padding="12,5"
                             Margin="5" />
        </Grid>

        <Grid Visibility="{Binding DisplaySaveButton, Converter={StaticResource BoolToVisibilityConverter}}">
            <StackPanel Orientation="Horizontal"
                        Visibility="{Binding EnableSaveSplitButton, Converter={StaticResource BoolToInverseVisibilityConverter}}">
                <Button Command="{Binding SaveWithoutVerificationCommand}"
                        mah:ControlsHelper.ContentCharacterCasing="Normal"
                        Style="{StaticResource FlowBlox.WindowActionButton}">
                    <StackPanel Orientation="Horizontal">
                        <iconPacks:PackIconMaterial Kind="ContentSaveAlertOutline"
                                                    Width="14"
                                                    Height="14"
                                                    Margin="0,0,8,0"
                                                    VerticalAlignment="Center"
                                                    Foreground="#D97706" />
                        <TextBlock Text="{x:Static resources:PropertyWindow.SaveWithoutVerification}"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <Button Content="{x:Static resources:PropertyWindow.Save}"
                        Command="{Binding SaveCommand}"
                        mah:ControlsHelper.ContentCharacterCasing="Normal"
                        Style="{StaticResource FlowBlox.WindowActionButton.Save}" />
            </StackPanel>

            <mah:SplitButton ItemsSource="{Binding SaveButtonActions}"
                             SelectedItem="{Binding SelectedSaveButtonAction, Mode=TwoWay}"
                             Command="{Binding SelectedSaveButtonAction.Command}"
                             ItemTemplate="{StaticResource CommitActionTemplate}"
                             Style="{StaticResource FlowBlox.WindowActionSplitButton}"
                             Visibility="{Binding EnableSaveSplitButton, Converter={StaticResource BoolToVisibilityConverter}}"
                             MinWidth="138"
                             Height="32"
                             Padding="12,5"
                             Margin="5" />
        </Grid>
    </StackPanel>
</UserControl>
