<mah:MetroWindow x:Class="FlowBlox.UICore.Views.AboutWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
    xmlns:icons="http://metro.mahapps.com/winfx/xaml/iconpacks"
    xmlns:texts="clr-namespace:FlowBlox.UICore.Resources"
    Title="{x:Static texts:AboutWindow.Title}" Width="580" SizeToContent="Height" ResizeMode="NoResize"
    ShowInTaskbar="False" WindowStartupLocation="CenterOwner">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="MahAppMetroResources.xaml" />
                <ResourceDictionary Source="Styles/FlowBloxCustomStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>
    <DockPanel Margin="20">
        <Border DockPanel.Dock="Top" Background="#353535" CornerRadius="8" Margin="0,0,0,20">
            <Image Source="/FlowBlox.UICore;component/Resources/Images/FlowBloxLogo.png" Height="160" Stretch="Uniform" AutomationProperties.Name="FlowBlox" />
        </Border>
        <Border DockPanel.Dock="Bottom" BorderBrush="{DynamicResource MahApps.Brushes.Gray5}" BorderThickness="0,1,0,0" Padding="0,12,0,0" Margin="0,20,0,0">
            <Button HorizontalAlignment="Right" MinWidth="120" IsDefault="True" IsCancel="True" Click="Close_Click">
                <StackPanel Orientation="Horizontal">
                    <icons:PackIconMaterial Kind="Close" Width="16" Height="16" Margin="0,0,8,0" VerticalAlignment="Center" />
                    <AccessText Text="{x:Static texts:AboutWindow.Close}" />
                </StackPanel>
            </Button>
        </Border>
        <GroupBox Header="{x:Static texts:AboutWindow.ProductInformation}">
            <StackPanel Margin="12">
                <TextBlock Text="{Binding ProductName}" FontSize="22" FontWeight="SemiBold" />
                <TextBlock Text="{Binding Version}" Margin="0,6,0,0" />
                <TextBlock Text="{Binding RuntimeVersion}" Margin="0,4,0,0" />
                <TextBlock Text="{Binding Description}" TextWrapping="Wrap" Margin="0,12,0,0" />
                <TextBlock Text="{Binding Copyright}" TextWrapping="Wrap" Margin="0,16,0,0" />
            </StackPanel>
        </GroupBox>
    </DockPanel>
</mah:MetroWindow>
