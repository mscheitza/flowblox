<UserControl x:Class="FlowBlox.UICore.Views.AIAssistantControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:viewModels="clr-namespace:FlowBlox.UICore.ViewModels"
             xmlns:views="clr-namespace:FlowBlox.UICore.Views"
             mc:Ignorable="d"
             d:DesignHeight="450"
             d:DesignWidth="450">
    <UserControl.DataContext>
        <viewModels:AIAssistantViewModel />
    </UserControl.DataContext>

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter" />
    </UserControl.Resources>

    <Grid Margin="8">
        <views:AiAssistantHistoryView DataContext="{Binding HistoryViewModel}"
                                      Visibility="{Binding IsHistoryOverviewVisible, Converter={StaticResource BoolToVisibilityConverter}}" />
        <views:AiAssistantChatView x:Name="ChatView"
                                   DataContext="{Binding ChatViewModel}"
                                   Visibility="{Binding IsChatVisible, Converter={StaticResource BoolToVisibilityConverter}}" />
    </Grid>
</UserControl>
