<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks">

    <!-- ====================== -->
    <!-- FlowBlox Custom Styles -->
    <!-- ====================== -->

    <!-- ========================================================= -->
    <!-- FlowBlox Toolbar Icon styling (PackIconMaterial)           -->
    <!-- Ensures proper disabled rendering (greyed out)             -->
    <!-- ========================================================= -->

    <!-- Neutral disabled icon brush (professional grey) -->
    <SolidColorBrush x:Key="FlowBlox.Icon.DisabledBrush" Color="#9AA3AF"/>

    <!-- Base style: enabled color comes from the derived style, disabled forces DisabledBrush -->
    <Style x:Key="FlowBlox.ToolbarIconBase"
       TargetType="{x:Type iconPacks:PackIconMaterial}">
        <Setter Property="Width" Value="16"/>
        <Setter Property="Height" Value="16"/>
        <Setter Property="Opacity" Value="1"/>
        <!-- Default enabled foreground (can be overridden by derived styles) -->
        <Setter Property="Foreground" Value="#5C6B73"/>

        <Style.Triggers>
            <!-- IsEnabled is inherited from the parent Button -->
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Foreground" Value="{StaticResource FlowBlox.Icon.DisabledBrush}"/>
                <Setter Property="Opacity" Value="1"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="FlowBlox.WindowActionIconBase"
           TargetType="{x:Type iconPacks:PackIconMaterial}"
           BasedOn="{StaticResource FlowBlox.ToolbarIconBase}">
        <Setter Property="Width" Value="14"/>
        <Setter Property="Height" Value="14"/>
        <Setter Property="Margin" Value="0,0,8,0"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <Style x:Key="FlowBlox.WindowActionIcon.Save"
           TargetType="{x:Type iconPacks:PackIconMaterial}"
           BasedOn="{StaticResource FlowBlox.WindowActionIconBase}">
        <Setter Property="Foreground" Value="#2E8B57"/>
    </Style>

    <Style x:Key="FlowBlox.WindowActionIcon.Back"
           TargetType="{x:Type iconPacks:PackIconMaterial}"
           BasedOn="{StaticResource FlowBlox.WindowActionIconBase}">
        <Setter Property="Foreground" Value="#5C6B73"/>
    </Style>

    <!-- Compact scroll bars used where content should stay visually lightweight. -->
    <Style x:Key="FlowBlox.ThinScrollThumb" TargetType="{x:Type Thumb}">
        <Setter Property="Background" Value="#7F91A3"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Thumb}">
                    <Border Background="{TemplateBinding Background}"
                            CornerRadius="2"/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="#5F7890"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <ControlTemplate x:Key="FlowBlox.ThinHorizontalScrollBarTemplate"
                     TargetType="{x:Type ScrollBar}">
        <Border Background="{TemplateBinding Background}"
                CornerRadius="2">
            <Track x:Name="PART_Track"
                   Orientation="Horizontal"
                   Minimum="{TemplateBinding Minimum}"
                   Maximum="{TemplateBinding Maximum}"
                   Value="{TemplateBinding Value}"
                   ViewportSize="{TemplateBinding ViewportSize}">
                <Track.Thumb>
                    <Thumb Style="{StaticResource FlowBlox.ThinScrollThumb}"/>
                </Track.Thumb>
            </Track>
        </Border>
    </ControlTemplate>

    <ControlTemplate x:Key="FlowBlox.ThinVerticalScrollBarTemplate"
                     TargetType="{x:Type ScrollBar}">
        <Border Background="{TemplateBinding Background}"
                CornerRadius="2">
            <Track x:Name="PART_Track"
                   Orientation="Vertical"
                   Minimum="{TemplateBinding Minimum}"
                   Maximum="{TemplateBinding Maximum}"
                   Value="{TemplateBinding Value}"
                   ViewportSize="{TemplateBinding ViewportSize}"
                   IsDirectionReversed="True">
                <Track.Thumb>
                    <Thumb Style="{StaticResource FlowBlox.ThinScrollThumb}"/>
                </Track.Thumb>
            </Track>
        </Border>
    </ControlTemplate>

    <Style x:Key="FlowBlox.ThinScrollBar" TargetType="{x:Type ScrollBar}">
        <Setter Property="Background" Value="#E1E6EB"/>
        <Style.Triggers>
            <Trigger Property="Orientation" Value="Horizontal">
                <Setter Property="Height" Value="5"/>
                <Setter Property="MinHeight" Value="5"/>
                <Setter Property="Template" Value="{StaticResource FlowBlox.ThinHorizontalScrollBarTemplate}"/>
            </Trigger>
            <Trigger Property="Orientation" Value="Vertical">
                <Setter Property="Width" Value="5"/>
                <Setter Property="MinWidth" Value="5"/>
                <Setter Property="Template" Value="{StaticResource FlowBlox.ThinVerticalScrollBarTemplate}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Keeps tab headers on one line and exposes a compact horizontal scrollbar on overflow. -->
    <Style x:Key="FlowBlox.ScrollableHeaderTabControl"
           TargetType="{x:Type TabControl}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type TabControl}">
                    <Grid KeyboardNavigation.TabNavigation="Local">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <ScrollViewer Grid.Row="0"
                                      HorizontalScrollBarVisibility="Auto"
                                      VerticalScrollBarVisibility="Disabled">
                            <ScrollViewer.Resources>
                                <Style TargetType="{x:Type ScrollBar}"
                                       BasedOn="{StaticResource FlowBlox.ThinScrollBar}"/>
                            </ScrollViewer.Resources>
                            <TabPanel IsItemsHost="True" Margin="2,0"/>
                        </ScrollViewer>
                        <ContentPresenter Grid.Row="1"
                                          ContentSource="SelectedContent"/>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
