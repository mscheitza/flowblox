<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks">

    <Style x:Key="FlowBlox.RoundedActionButtonStyle"
       TargetType="{x:Type Button}">
        <Setter Property="MinWidth" Value="96" />
        <Setter Property="Height" Value="32" />
        <Setter Property="Padding" Value="12,0" />

        <Setter Property="Background" Value="#FFF3F6FA" />
        <Setter Property="Foreground" Value="#FF244B66" />
        <Setter Property="BorderBrush" Value="#FFD1D9E2" />
        <Setter Property="BorderThickness" Value="1" />

        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />

        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Button}">
                    <Border x:Name="ButtonBorder"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="7"
                        SnapsToDevicePixels="True">

                        <ContentPresenter
                        Margin="{TemplateBinding Padding}"
                        HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                        VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                        RecognizesAccessKey="True" />
                    </Border>

                    <ControlTemplate.Triggers>

                        <Trigger Property="IsMouseOver"
                             Value="True">
                            <Setter TargetName="ButtonBorder"
                                Property="Background"
                                Value="#FFE8F3FF" />
                            <Setter TargetName="ButtonBorder"
                                Property="BorderBrush"
                                Value="#FF9CC5E8" />
                            <Setter Property="Foreground"
                                Value="#FF1565C0" />
                        </Trigger>

                        <Trigger Property="IsPressed"
                             Value="True">
                            <Setter TargetName="ButtonBorder"
                                Property="Background"
                                Value="#FFD9EBFA" />
                            <Setter TargetName="ButtonBorder"
                                Property="BorderBrush"
                                Value="#FF6EA4D2" />
                        </Trigger>

                        <Trigger Property="IsEnabled"
                             Value="False">
                            <Setter TargetName="ButtonBorder"
                                Property="Background"
                                Value="#FFF3F4F6" />
                            <Setter TargetName="ButtonBorder"
                                Property="BorderBrush"
                                Value="#FFE1E4E8" />
                            <Setter Property="Foreground"
                                Value="#FF9CA3AF" />
                            <Setter Property="Opacity"
                                Value="0.72" />
                        </Trigger>

                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="FlowBlox.EmptyStateIconStyle" TargetType="{x:Type iconPacks:PackIconMaterial}">
        <Setter Property="Width" Value="18" />
        <Setter Property="Height" Value="18" />
        <Setter Property="Foreground" Value="#8F98A3" />
    </Style>

    <Style x:Key="FlowBlox.EmptyStateTextStyle" TargetType="{x:Type TextBlock}">
        <Setter Property="Foreground" Value="#8F98A3" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style x:Key="HostedControlToolbarIconBase" TargetType="{x:Type iconPacks:PackIconMaterial}">
        <Setter Property="Width" Value="16" />
        <Setter Property="Height" Value="16" />
        <Setter Property="Opacity" Value="1" />
        <Setter Property="Foreground" Value="#FF4E7FB3" />
        <Style.Triggers>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Foreground" Value="#9AA3AF" />
                <Setter Property="Opacity" Value="1" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="HostedControlContextMenuIconBase" TargetType="{x:Type iconPacks:PackIconMaterial}">
        <Setter Property="Width" Value="16" />
        <Setter Property="Height" Value="16" />
        <Setter Property="Margin" Value="0" />
        <Setter Property="Opacity" Value="1" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding IsEnabled, RelativeSource={RelativeSource AncestorType={x:Type MenuItem}}}" Value="False">
                <Setter Property="Foreground" Value="#9AA3AF" />
                <Setter Property="Opacity" Value="1" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style
        x:Key="HostedControlContextMenuIcon.Primary"
        BasedOn="{StaticResource HostedControlContextMenuIconBase}"
        TargetType="{x:Type iconPacks:PackIconMaterial}">
        <Setter Property="Foreground" Value="#2563EB" />
    </Style>

    <Style
        x:Key="HostedControlContextMenuIcon.Success"
        BasedOn="{StaticResource HostedControlContextMenuIconBase}"
        TargetType="{x:Type iconPacks:PackIconMaterial}">
        <Setter Property="Foreground" Value="#16A34A" />
    </Style>

    <Style
        x:Key="HostedControlContextMenuIcon.Teal"
        BasedOn="{StaticResource HostedControlContextMenuIconBase}"
        TargetType="{x:Type iconPacks:PackIconMaterial}">
        <Setter Property="Foreground" Value="#0F766E" />
    </Style>

    <Style
        x:Key="HostedControlContextMenuIcon.Info"
        BasedOn="{StaticResource HostedControlContextMenuIconBase}"
        TargetType="{x:Type iconPacks:PackIconMaterial}">
        <Setter Property="Foreground" Value="#0284C7" />
    </Style>

    <Style
        x:Key="HostedControlContextMenuIcon.Warning"
        BasedOn="{StaticResource HostedControlContextMenuIconBase}"
        TargetType="{x:Type iconPacks:PackIconMaterial}">
        <Setter Property="Foreground" Value="#D97706" />
    </Style>

    <Style
        x:Key="HostedControlContextMenuIcon.Danger"
        BasedOn="{StaticResource HostedControlContextMenuIconBase}"
        TargetType="{x:Type iconPacks:PackIconMaterial}">
        <Setter Property="Foreground" Value="#B91C1C" />
    </Style>

    <Style
        x:Key="HostedControlContextMenuIcon.Purple"
        BasedOn="{StaticResource HostedControlContextMenuIconBase}"
        TargetType="{x:Type iconPacks:PackIconMaterial}">
        <Setter Property="Foreground" Value="#7C3AED" />
    </Style>

    <Style
        x:Key="HostedControlContextMenuIcon.Neutral"
        BasedOn="{StaticResource HostedControlContextMenuIconBase}"
        TargetType="{x:Type iconPacks:PackIconMaterial}">
        <Setter Property="Foreground" Value="#475569" />
    </Style>

</ResourceDictionary>