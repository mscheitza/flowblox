<mah:MetroWindow
    x:Class="FlowBlox.UICore.Views.EditContentView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
    xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
    xmlns:viewModel="clr-namespace:FlowBlox.UICore.ViewModels"
    xmlns:resources="clr-namespace:FlowBlox.UICore.Resources"
    xmlns:avalonedit="http://icsharpcode.net/sharpdevelop/avalonedit"
    mc:Ignorable="d"
    Title="{x:Static resources:EditContentView.Window_Title}"
    Height="600" Width="900">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/FlowBlox.UICore;component/Views/MahAppMetroResources.xaml" />
                <ResourceDictionary Source="/FlowBlox.UICore;component/Views/Styles/FlowBloxCustomStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
        </ResourceDictionary>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ToolBar Grid.Row="0" Padding="4">
            <Button Command="{Binding ImportTextFromFileCommand}"
                    Visibility="{Binding CanEdit, Converter={StaticResource BooleanToVisibilityConverter}}"
                    ToolTip="{x:Static resources:EditContentView.Toolbar_ImportText_Tooltip}">
                <StackPanel Orientation="Horizontal">
                    <iconPacks:PackIconMaterial Kind="FileImport" Foreground="#1565C0" Width="16" Height="16" Margin="0,0,6,0"/>
                    <TextBlock Text="{x:Static resources:EditContentView.Toolbar_ImportText}"/>
                </StackPanel>
            </Button>

            <Button Command="{Binding ImportBytesFromFileCommand}"
                    Visibility="{Binding CanEdit, Converter={StaticResource BooleanToVisibilityConverter}}"
                    Margin="6,0,0,0"
                    ToolTip="{x:Static resources:EditContentView.Toolbar_ImportBytes_Tooltip}">
                <StackPanel Orientation="Horizontal">
                    <iconPacks:PackIconMaterial Kind="DatabaseImport" Foreground="#6A1B9A" Width="16" Height="16" Margin="0,0,6,0"/>
                    <TextBlock Text="{x:Static resources:EditContentView.Toolbar_ImportBytes}"/>
                </StackPanel>
            </Button>

            <Button x:Name="InsertFieldPlaceholderButton"
                    Margin="6,0,0,0"
                    Visibility="{Binding ShowFieldPlaceholderButton, Converter={StaticResource BooleanToVisibilityConverter}}"
                    Click="InsertFieldPlaceholderButton_Click"
                    ToolTip="{x:Static resources:EditContentView.Toolbar_InsertPlaceholder_Tooltip}">
                <StackPanel Orientation="Horizontal">
                    <iconPacks:PackIconMaterial Kind="Variable" Foreground="#2F6DB3" Width="16" Height="16" Margin="0,0,6,0"/>
                    <TextBlock Text="{x:Static resources:EditContentView.Toolbar_InsertPlaceholder}"/>
                </StackPanel>
            </Button>

            <Separator Margin="6,0,6,0"/>

            <TextBlock Text="{x:Static resources:EditContentView.Label_Syntax}" VerticalAlignment="Center" Margin="0,0,6,0"/>
            <ComboBox ItemsSource="{Binding AvailableHighlightingNames}"
                      SelectedItem="{Binding SelectedHighlightingName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                      MinWidth="180"
                      ToolTip="{x:Static resources:EditContentView.Combo_Syntax_Tooltip}" />
        </ToolBar>

        <avalonedit:TextEditor Grid.Row="1"
                               x:Name="Editor"
                               Document="{Binding Document}"
                               IsReadOnly="{Binding IsReadOnly}"
                               FontFamily="JetBrains Mono"
                               FontSize="12"
                               ShowLineNumbers="True"
                               HorizontalScrollBarVisibility="Auto"
                               VerticalScrollBarVisibility="Auto"
                               SyntaxHighlighting="{Binding SelectedHighlightingDefinition}" />

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="8">
            <Button Content="{x:Static resources:EditContentView.Button_Back}"
                    Command="{Binding CancelCommand}"
                    IsCancel="True"
                    Style="{StaticResource FlowBlox.WindowActionButton.Back}" />

            <Button Content="{x:Static resources:EditContentView.Button_Save}"
                    Command="{Binding SaveCommand}"
                    IsDefault="True"
                    Visibility="{Binding CanEdit, Converter={StaticResource BooleanToVisibilityConverter}}"
                    Style="{StaticResource FlowBlox.WindowActionButton.Save}" />
        </StackPanel>
    </Grid>
</mah:MetroWindow>
