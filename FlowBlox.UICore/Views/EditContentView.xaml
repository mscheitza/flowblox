<mah:MetroWindow
    x:Class="FlowBlox.UICore.Views.EditContentView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
    xmlns:views="clr-namespace:FlowBlox.UICore.Views"
    xmlns:resources="clr-namespace:FlowBlox.UICore.Resources"
    Title="{x:Static resources:EditContentView.Window_Title}"
    Height="600" Width="900">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/FlowBlox.UICore;component/Views/MahAppMetroResources.xaml" />
                <ResourceDictionary Source="/FlowBlox.UICore;component/Views/Styles/FlowBloxCustomStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <BooleanToVisibilityConverter x:Key="VisibleIfTrue" />
        </ResourceDictionary>
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <views:InnerContentView />
        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="8">
            <Button Content="{x:Static resources:EditContentView.Button_Back}"
                    Command="{Binding CancelCommand}" IsCancel="True"
                    Style="{StaticResource FlowBlox.WindowActionButton.Back}" />
            <Button Content="{x:Static resources:EditContentView.Button_Save}"
                    Command="{Binding SaveCommand}" IsDefault="True"
                    Visibility="{Binding CanEdit, Converter={StaticResource VisibleIfTrue}}"
                    Style="{StaticResource FlowBlox.WindowActionButton.Save}" />
        </StackPanel>
    </Grid>
</mah:MetroWindow>
