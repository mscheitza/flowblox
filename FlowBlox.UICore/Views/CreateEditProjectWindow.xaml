<mah:MetroWindow x:Class="FlowBlox.UICore.Views.CreateEditProjectWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
    xmlns:icons="http://metro.mahapps.com/winfx/xaml/iconpacks"
    xmlns:texts="clr-namespace:FlowBlox.UICore.Resources"
    xmlns:avalonedit="http://icsharpcode.net/sharpdevelop/avalonedit"
    Title="{Binding Title}" Width="780" Height="760" MinWidth="620" MinHeight="480"
    ShowInTaskbar="False" WindowStartupLocation="CenterOwner">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="MahAppMetroResources.xaml" />
                <ResourceDictionary Source="Styles/FlowBloxCustomStyles.xaml" />
                <ResourceDictionary Source="Styles/PropertyViewStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <Style TargetType="Label" BasedOn="{StaticResource MahApps.Styles.Label}">
                <Setter Property="Margin" Value="0,9,0,5" />
                <Setter Property="Padding" Value="5" />
                <Setter Property="Background" Value="#D9E6F2" />
                <Setter Property="Foreground" Value="Black" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Label">
                            <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}" CornerRadius="4">
                                <StackPanel Orientation="Horizontal">
                                    <ContentPresenter ContentSource="Content" RecognizesAccessKey="True" VerticalAlignment="Center" />
                                    <Border x:Name="HelpIcon" Style="{StaticResource PropertyView.HelpIconBorderStyle}">
                                        <TextBlock Text="?" FontSize="11" FontWeight="Bold" Foreground="White"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                </StackPanel>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="ToolTip" Value="{x:Null}">
                                    <Setter TargetName="HelpIcon" Property="Visibility" Value="Collapsed" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <Style TargetType="avalonedit:TextEditor">
                <Setter Property="FontFamily" Value="{DynamicResource MahApps.Fonts.Family.Control}" />
                <Setter Property="FontSize" Value="{DynamicResource MahApps.Font.Size.Content}" />
                <Setter Property="Background" Value="{DynamicResource MahApps.Brushes.Control.Background}" />
                <Setter Property="Foreground" Value="{DynamicResource MahApps.Brushes.Text}" />
                <Setter Property="BorderBrush" Value="{DynamicResource MahApps.Brushes.TextBox.Border}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="Padding" Value="4" />
                <Setter Property="WordWrap" Value="True" />
                <Setter Property="ShowLineNumbers" Value="False" />
                <Setter Property="VerticalScrollBarVisibility" Value="Auto" />
                <Setter Property="HorizontalScrollBarVisibility" Value="Disabled" />
            </Style>
        </ResourceDictionary>
    </Window.Resources>
    <DockPanel Margin="20">
        <Border DockPanel.Dock="Top" Background="{DynamicResource MahApps.Brushes.Gray10}" Padding="12" CornerRadius="4">
            <StackPanel>
                <StackPanel Orientation="Horizontal">
                    <icons:PackIconMaterial Kind="FileDocumentEditOutline" Width="28" Height="28" Margin="0,0,12,0" />
                    <TextBlock Text="{Binding Title}" FontSize="20" FontWeight="SemiBold" VerticalAlignment="Center" />
                </StackPanel>
                <TextBlock Text="{x:Static texts:CreateEditProjectWindow.DescriptionHint}" TextWrapping="Wrap" Margin="0,10,0,0" />
            </StackPanel>
        </Border>
        <Border DockPanel.Dock="Bottom" BorderBrush="{DynamicResource MahApps.Brushes.Gray5}" BorderThickness="0,1,0,0" Margin="0,16,0,0" Padding="0,12,0,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Command="{Binding CancelCommand}" IsCancel="True" Style="{StaticResource FlowBlox.WindowActionButton}">
                    <StackPanel Orientation="Horizontal">
                        <icons:PackIconMaterial Kind="ArrowLeft" Style="{StaticResource FlowBlox.WindowActionIcon.Back}" />
                        <AccessText Text="{x:Static texts:CreateEditProjectWindow.Cancel}" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <Button Command="{Binding ApplyCommand}" IsDefault="True" Style="{StaticResource FlowBlox.WindowActionButton}">
                    <StackPanel Orientation="Horizontal">
                        <icons:PackIconMaterial Kind="Check" Style="{StaticResource FlowBlox.WindowActionIcon.Apply}" />
                        <AccessText Text="{x:Static texts:CreateEditProjectWindow.Apply}" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Border>
        <TextBlock DockPanel.Dock="Bottom" Text="{Binding ErrorText}" Foreground="{DynamicResource MahApps.Brushes.ValidationError}" TextWrapping="Wrap" Margin="0,8,0,0" AutomationProperties.LiveSetting="Assertive" />
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="0,0,0,4">
            <StackPanel Margin="0,0,8,0">
                <Label Content="{x:Static texts:CreateEditProjectWindow.ProjectName}" Target="{Binding ElementName=ProjectNameInput}" />
                <TextBox x:Name="ProjectNameInput" Text="{Binding ProjectName, UpdateSourceTrigger=PropertyChanged}" />
                <Label Content="{x:Static texts:CreateEditProjectWindow.InputDirectory}" Target="{Binding ElementName=InputPath}"
                       ToolTip="{x:Static texts:CreateEditProjectWindow.InputDirectoryTooltip}" />
                <DockPanel>
                    <Button DockPanel.Dock="Right" Command="{Binding OpenInputDirectoryCommand}" ToolTip="{x:Static texts:CreateEditProjectWindow.OpenDirectory}" AutomationProperties.Name="{x:Static texts:CreateEditProjectWindow.OpenDirectory}" Margin="6,0,0,0" Width="36"><icons:PackIconMaterial Kind="FolderOpenOutline" Width="18" Height="18" /></Button>
                    <Button DockPanel.Dock="Right" Command="{Binding CreateInputDirectoryCommand}" ToolTip="{x:Static texts:CreateEditProjectWindow.CreateDirectory}" AutomationProperties.Name="{x:Static texts:CreateEditProjectWindow.CreateDirectory}" Margin="6,0,0,0" Width="36"><icons:PackIconMaterial Kind="FolderPlusOutline" Width="18" Height="18" /></Button>
                    <TextBox x:Name="InputPath" Text="{Binding InputDirectory, Mode=OneWay}" IsReadOnly="True" />
                </DockPanel>
                <Label Content="{x:Static texts:CreateEditProjectWindow.OutputDirectory}" Target="{Binding ElementName=OutputPath}"
                       ToolTip="{x:Static texts:CreateEditProjectWindow.OutputDirectoryTooltip}" />
                <DockPanel>
                    <Button DockPanel.Dock="Right" Command="{Binding OpenOutputDirectoryCommand}" ToolTip="{x:Static texts:CreateEditProjectWindow.OpenDirectory}" AutomationProperties.Name="{x:Static texts:CreateEditProjectWindow.OpenDirectory}" Margin="6,0,0,0" Width="36"><icons:PackIconMaterial Kind="FolderOpenOutline" Width="18" Height="18" /></Button>
                    <Button DockPanel.Dock="Right" Command="{Binding CreateOutputDirectoryCommand}" ToolTip="{x:Static texts:CreateEditProjectWindow.CreateDirectory}" AutomationProperties.Name="{x:Static texts:CreateEditProjectWindow.CreateDirectory}" Margin="6,0,0,0" Width="36"><icons:PackIconMaterial Kind="FolderPlusOutline" Width="18" Height="18" /></Button>
                    <TextBox x:Name="OutputPath" Text="{Binding OutputDirectory, Mode=OneWay}" IsReadOnly="True" />
                </DockPanel>
                <Label Content="{x:Static texts:CreateEditProjectWindow.Author}" Target="{Binding ElementName=AuthorInput}" />
                <TextBox x:Name="AuthorInput" Text="{Binding Author, UpdateSourceTrigger=PropertyChanged}" />
                <Label Content="{x:Static texts:CreateEditProjectWindow.ShortDescription}" Target="{Binding ElementName=ShortDescriptionInput}" />
                <TextBox x:Name="ShortDescriptionInput" Text="{Binding ShortDescription, UpdateSourceTrigger=PropertyChanged}" />
                <Label x:Name="DescriptionLabel" Content="{x:Static texts:CreateEditProjectWindow.Description}" Target="{Binding ElementName=DescriptionInput}"
                       ToolTip="{x:Static texts:CreateEditProjectWindow.DescriptionTooltip}" />
                <avalonedit:TextEditor x:Name="DescriptionInput" Document="{Binding DescriptionDocument}" Height="90"
                                       AutomationProperties.LabeledBy="{Binding ElementName=DescriptionLabel}">
                    <avalonedit:TextEditor.Options>
                        <avalonedit:TextEditorOptions WordWrapIndentation="14" InheritWordWrapIndentation="False" ShowEndOfLine="False" />
                    </avalonedit:TextEditor.Options>
                </avalonedit:TextEditor>
                <Label x:Name="NoticeLabel" Content="{x:Static texts:CreateEditProjectWindow.Notice}" Target="{Binding ElementName=NoticeInput}"
                       ToolTip="{x:Static texts:CreateEditProjectWindow.NoticeTooltip}" />
                <avalonedit:TextEditor x:Name="NoticeInput" Document="{Binding NoticeDocument}" Height="75"
                                       AutomationProperties.LabeledBy="{Binding ElementName=NoticeLabel}">
                    <avalonedit:TextEditor.Options>
                        <avalonedit:TextEditorOptions WordWrapIndentation="14" InheritWordWrapIndentation="False" ShowEndOfLine="False" />
                    </avalonedit:TextEditor.Options>
                </avalonedit:TextEditor>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</mah:MetroWindow>
