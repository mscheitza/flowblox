<mah:MetroWindow
    xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
    x:Class="FlowBlox.UICore.Views.ExampleProjectsWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:resources="clr-namespace:FlowBlox.UICore.Resources"
    xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
    Title="{x:Static resources:ExampleProjectsWindow.Title}"
    Width="820"
    Height="620"
    MinWidth="640"
    MinHeight="420"
    WindowStartupLocation="CenterOwner">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/FlowBlox.UICore;component/Views/MahAppMetroResources.xaml" />
                <ResourceDictionary Source="/FlowBlox.UICore;component/Views/Styles/FlowBloxCustomStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <DockPanel Margin="10">
        <Border DockPanel.Dock="Top" Background="#FFEEEEEE" Height="50" Padding="8">
            <StackPanel Orientation="Horizontal">
                <iconPacks:PackIconMaterial Kind="PresentationPlay"
                                            Width="30"
                                            Height="30"
                                            Margin="0,0,10,0"
                                            VerticalAlignment="Center"
                                            Foreground="#00D4FF" />
                <TextBlock Text="{x:Static resources:ExampleProjectsWindow.Header_Title}"
                           FontWeight="Bold"
                           VerticalAlignment="Center"
                           FontSize="16" />
            </StackPanel>
        </Border>

        <Border DockPanel.Dock="Top"
                Background="#EDF3F9"
                Padding="12"
                CornerRadius="4"
                Margin="0,8,0,10">
            <TextBlock Text="{x:Static resources:ExampleProjectsWindow.Header_Description}"
                       Foreground="DarkSlateGray"
                       TextWrapping="Wrap" />
        </Border>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <ListBox Grid.Row="0"
                     ItemsSource="{Binding Projects}"
                     SelectedItem="{Binding SelectedProject}"
                     BorderThickness="0"
                     Background="Transparent"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     MouseDoubleClick="ProjectsList_MouseDoubleClick">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Setter Property="Padding" Value="0" />
                        <Setter Property="Margin" Value="0,0,0,8" />
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Border Padding="14"
                                Background="#FFF7F9FB"
                                BorderBrush="#FFD5DEE7"
                                BorderThickness="1"
                                CornerRadius="5">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <Border Width="42"
                                        Height="42"
                                        Margin="0,0,12,0"
                                        Background="#1400D4FF"
                                        CornerRadius="21">
                                    <iconPacks:PackIconMaterial Kind="PresentationPlay"
                                                                Width="23"
                                                                Height="23"
                                                                HorizontalAlignment="Center"
                                                                VerticalAlignment="Center"
                                                                Foreground="#00D4FF" />
                                </Border>

                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Name}"
                                               FontSize="15"
                                               FontWeight="SemiBold"
                                               Foreground="#263238" />
                                    <TextBlock Text="{Binding Description}"
                                               Margin="0,4,12,0"
                                               Foreground="#546E7A"
                                               TextWrapping="Wrap" />
                                </StackPanel>

                                <TextBlock Grid.Column="2"
                                           Text="{Binding CreatedAt, StringFormat={}{0:g}}"
                                           Foreground="#9AA5AE"
                                           FontSize="11"
                                           Margin="12,2,0,0"
                                           VerticalAlignment="Top" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <StackPanel Grid.Row="1"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        Margin="0,10,0,0">
                <Button Content="{x:Static resources:ExampleProjectsWindow.Button_Back}"
                        Style="{StaticResource FlowBlox.WindowActionButton.Back}"
                        Command="{Binding BackCommand}"
                        IsCancel="True" />
                <Button Command="{Binding OpenCommand}"
                        IsDefault="True"
                        Style="{StaticResource FlowBlox.WindowActionButton}">
                    <Button.Content>
                        <StackPanel Orientation="Horizontal">
                            <iconPacks:PackIconMaterial Kind="PresentationPlay"
                                                        Width="14"
                                                        Height="14"
                                                        Margin="0,0,6,0"
                                                        Foreground="#00D4FF" />
                            <TextBlock Text="{x:Static resources:ExampleProjectsWindow.Button_Open}" />
                        </StackPanel>
                    </Button.Content>
                </Button>
            </StackPanel>
        </Grid>
    </DockPanel>
</mah:MetroWindow>
