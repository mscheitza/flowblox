<UserControl x:Class="FlowBlox.UICore.Views.AiAssistantHistoryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
             xmlns:resources="clr-namespace:FlowBlox.UICore.Resources"
             mc:Ignorable="d"
             d:DesignHeight="450"
             d:DesignWidth="450">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/FlowBlox.UICore;component/Views/Styles/FlowBloxCustomStyles.xaml" />
                <ResourceDictionary Source="/FlowBlox.UICore;component/Views/Styles/HostedControlStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid Background="#FFFFFFFF">
        <ListBox ItemsSource="{Binding Histories}"
                 BorderBrush="#FFD0D0D0"
                 BorderThickness="1"
                 Background="#FFFFFFFF"
                 HorizontalContentAlignment="Stretch">
            <ListBox.Style>
                <Style TargetType="{x:Type ListBox}">
                    <Setter Property="Visibility" Value="Visible" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding HasHistories}" Value="False">
                            <Setter Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </ListBox.Style>
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Button Command="{Binding DataContext.OpenHistoryCommand, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                            CommandParameter="{Binding}"
                            BorderThickness="0"
                            Background="Transparent"
                            Padding="0"
                            HorizontalContentAlignment="Stretch">
                        <Border Padding="10"
                                BorderBrush="#FFE5E7EB"
                                BorderThickness="0,0,0,1">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <iconPacks:PackIconMaterial Grid.Column="0"
                                                            Kind="History"
                                                            Width="20"
                                                            Height="20"
                                                            Margin="0,1,10,0"
                                                            Foreground="#FF4B5563"
                                                            VerticalAlignment="Top" />
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="{Binding DisplayTimestamp}"
                                               FontWeight="SemiBold"
                                               Foreground="#FF1F2937" />
                                    <TextBlock Text="{Binding Preview}"
                                               Margin="0,4,0,0"
                                               Foreground="#FF6B7280"
                                               TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </Button>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <Border Background="#FFFFFFFF"
                BorderBrush="#FFD0D0D0"
                BorderThickness="1"
                Padding="24">
            <Border.Style>
                <Style TargetType="{x:Type Border}">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding HasHistories}" Value="False">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <StackPanel HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        MaxWidth="280">
                <iconPacks:PackIconMaterial Kind="MessageTextClockOutline"
                                            Width="48"
                                            Height="48"
                                            Foreground="#FF8AA0B2"
                                            HorizontalAlignment="Center" />
                <TextBlock Text="{x:Static resources:AiAssistantHistoryView.Empty_Title}"
                           FontWeight="SemiBold"
                           FontSize="14"
                           Foreground="#FF1F2937"
                           TextAlignment="Center"
                           Margin="0,14,0,0" />
                <TextBlock Text="{x:Static resources:AiAssistantHistoryView.Empty_Description}"
                           Foreground="#FF6B7280"
                           TextWrapping="Wrap"
                           TextAlignment="Center"
                           Margin="0,6,0,0" />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
