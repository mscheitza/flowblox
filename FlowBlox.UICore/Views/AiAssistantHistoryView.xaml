<UserControl x:Class="FlowBlox.UICore.Views.AiAssistantHistoryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:resources="clr-namespace:FlowBlox.UICore.Resources"
             mc:Ignorable="d"
             d:DesignHeight="450"
             d:DesignWidth="450">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/FlowBlox.UICore;component/Views/Styles/FlowBloxCustomStyles.xaml" />
                <ResourceDictionary Source="/FlowBlox.UICore;component/Views/Styles/HostedControlStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Background="#FFEEEEEE"
                Height="48"
                Padding="10,6">
            <TextBlock Text="{x:Static resources:AiAssistantHistoryView.History_Title}"
                       FontWeight="Bold"
                       VerticalAlignment="Center"
                       FontSize="16" />
        </Border>

        <ListBox Grid.Row="1"
                 ItemsSource="{Binding Histories}"
                 BorderBrush="#FFD0D0D0"
                 BorderThickness="1"
                 Margin="0,8,0,8"
                 HorizontalContentAlignment="Stretch">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Border Padding="10"
                            BorderBrush="#FFE5E7EB"
                            BorderThickness="0,0,0,1">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="{Binding DisplayTimestamp}"
                                           FontWeight="SemiBold"
                                           Foreground="#FF1F2937" />
                                <TextBlock Text="{Binding Preview}"
                                           Margin="0,4,12,0"
                                           Foreground="#FF6B7280"
                                           TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                            <Button Grid.Column="1"
                                    MinWidth="80"
                                    Content="{x:Static resources:AiAssistantHistoryView.Button_OpenHistory}"
                                    Command="{Binding DataContext.OpenHistoryCommand, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                                    CommandParameter="{Binding}" />
                        </Grid>
                    </Border>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <Button Grid.Row="2"
                HorizontalAlignment="Right"
                MinWidth="120"
                Content="{x:Static resources:AiAssistantHistoryView.Button_NewHistory}"
                Style="{StaticResource FlowBlox.RoundedActionButtonStyle}"
                Command="{Binding NewHistoryCommand}" />
    </Grid>
</UserControl>
