<mah:MetroWindow x:Class="FlowBlox.UICore.Views.ExternalProjectExecutionConfirmationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
        xmlns:resources="clr-namespace:FlowBlox.UICore.Resources"
        xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
        Title="{x:Static resources:AiAssistantChatView.Message_ExternalProjectExecution_Confirm_Title}"
        Width="620" Height="330" SizeToContent="Height"
        ResizeMode="NoResize" WindowStartupLocation="CenterOwner">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/FlowBlox.UICore;component/Views/MahAppMetroResources.xaml" />
                <ResourceDictionary Source="/FlowBlox.UICore;component/Views/Styles/FlowBloxCustomStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <iconPacks:PackIconMaterial Kind="ShieldAlertOutline"
                                        Width="28"
                                        Height="28"
                                        Margin="0,0,12,0"
                                        VerticalAlignment="Center"
                                        Foreground="DarkGoldenrod" />
            <TextBlock Text="{x:Static resources:AiAssistantChatView.Message_ExternalProjectExecution_Confirm_Description}"
                       Grid.Column="1"
                       TextWrapping="Wrap"
                       VerticalAlignment="Center"
                       FontSize="14" />
        </Grid>
        <Border Grid.Row="1" Margin="0,14,0,0" Padding="12" Background="#FFF5E6" CornerRadius="4">
            <StackPanel>
                <TextBlock Text="{x:Static resources:AiAssistantChatView.Message_ExternalProjectExecution_Reason}"
                           FontWeight="SemiBold" />
                <TextBlock x:Name="ReasonText" Margin="0,5,0,0" TextWrapping="Wrap" />
            </StackPanel>
        </Border>
        <TextBlock x:Name="ProjectFileText" Grid.Row="2" Margin="0,12,0,0" TextWrapping="Wrap" />

        <StackPanel Grid.Row="3" Margin="0,20,0,0" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button x:Name="ReviewButton"
                    Content="{x:Static resources:AiAssistantChatView.Message_ExternalProjectExecution_Review}"
                    Style="{StaticResource FlowBlox.WindowActionButton}"
                    Click="ReviewButton_Click" />
            <Button Content="{x:Static resources:AiAssistantChatView.Message_ExternalProjectExecution_Cancel}"
                    Style="{StaticResource FlowBlox.WindowActionButton.Back}"
                    IsCancel="True"
                    Click="CancelButton_Click" />
            <Button Content="{x:Static resources:AiAssistantChatView.Message_ExternalProjectExecution_Execute}"
                    Style="{StaticResource FlowBlox.WindowActionButton.Save}"
                    IsDefault="True"
                    Click="ExecuteButton_Click" />
        </StackPanel>
    </Grid>
</mah:MetroWindow>
