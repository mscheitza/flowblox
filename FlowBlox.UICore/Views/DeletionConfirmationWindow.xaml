<mah:MetroWindow x:Class="FlowBlox.UICore.Views.DeletionConfirmationWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
    xmlns:icons="http://metro.mahapps.com/winfx/xaml/iconpacks"
    Title="{Binding Title}" Width="920" Height="680" MinWidth="720" MinHeight="480"
    WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/FlowBlox.UICore;component/Views/MahAppMetroResources.xaml" />
                <ResourceDictionary Source="/FlowBlox.UICore;component/Views/Styles/FlowBloxCustomStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Background="#FFF8E1"
                BorderBrush="#FFE0B2"
                BorderThickness="1"
                CornerRadius="4"
                Padding="16"
                Margin="20,20,20,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <icons:PackIconMaterial Kind="AlertCircleOutline"
                                        Width="34"
                                        Height="34"
                                        Margin="0,1,14,0"
                                        VerticalAlignment="Top"
                                        Foreground="#FFD97706" />
                <StackPanel Grid.Column="1">
                    <TextBlock Text="{Binding HeaderTitle}"
                               FontSize="16"
                               FontWeight="SemiBold"
                               Foreground="#FF6D5A21"
                               Margin="0,0,0,5" />
                    <TextBlock Text="{Binding Description}"
                               Foreground="#FF6D5A21"
                               TextWrapping="Wrap" />
                </StackPanel>
            </Grid>
        </Border>

        <ListBox Grid.Row="1"
                 Margin="20,0,20,16"
                 Padding="0"
                 BorderThickness="0"
                 Background="Transparent"
                 ItemsSource="{Binding Entries}"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem">
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    <Setter Property="Padding" Value="0" />
                    <Setter Property="Margin" Value="0,0,0,6" />
                    <Setter Property="Focusable" Value="False" />
                </Style>
            </ListBox.ItemContainerStyle>
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Border Padding="11"
                            Background="{Binding CardBackground}"
                            BorderBrush="{Binding CardBorder}"
                            BorderThickness="1"
                            CornerRadius="5">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <Border Grid.RowSpan="3"
                                    Width="34"
                                    Height="34"
                                    Margin="0,1,11,0"
                                    VerticalAlignment="Top"
                                    Background="{Binding IconBackground}"
                                    CornerRadius="17">
                                <icons:PackIconMaterial Kind="{Binding Icon}"
                                                        Width="18"
                                                        Height="18"
                                                        HorizontalAlignment="Center"
                                                        VerticalAlignment="Center"
                                                        Foreground="{Binding Accent}" />
                            </Border>

                            <StackPanel Grid.Column="1" Margin="0,0,12,0">
                                <TextBlock Text="{Binding ObjectType}"
                                           FontSize="10.5"
                                           FontWeight="SemiBold"
                                           Foreground="{Binding Accent}" />
                                <TextBlock Text="{Binding ObjectName}"
                                           Margin="0,1,0,0"
                                           FontSize="13"
                                           FontWeight="SemiBold"
                                           Foreground="#FF263238"
                                           TextWrapping="Wrap" />
                            </StackPanel>

                            <Border Grid.Column="2"
                                    Padding="8,3"
                                    VerticalAlignment="Top"
                                    Background="{Binding StatusBackground}"
                                    CornerRadius="3">
                                <TextBlock Text="{Binding Status}"
                                           FontSize="11"
                                           FontWeight="SemiBold"
                                           Foreground="{Binding Accent}" />
                            </Border>

                            <StackPanel Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Margin="0,6,0,0">
                                <TextBlock Text="{Binding PropertyLabel}"
                                           FontSize="11"
                                           FontWeight="SemiBold"
                                           Foreground="#FF607D8B" />
                                <TextBlock Text="{Binding Property}"
                                           Margin="0,1,0,0"
                                           Foreground="#FF37474F"
                                           TextWrapping="Wrap" />
                            </StackPanel>

                            <StackPanel Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2" Margin="0,6,0,0">
                                <TextBlock Text="{Binding ImpactLabel}"
                                           FontSize="11"
                                           FontWeight="SemiBold"
                                           Foreground="#FF607D8B" />
                                <TextBlock Text="{Binding Impact}"
                                           Margin="0,1,0,0"
                                           Foreground="#FF37474F"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
        <Border Grid.Row="2"
                Background="#FFF7F9FB"
                BorderBrush="#FFD4DEE9"
                BorderThickness="0,1,0,0"
                Padding="15,10">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="{Binding BackText}"
                        Style="{StaticResource FlowBlox.WindowActionButton.Back}"
                        IsCancel="True" />
                <Button Content="{Binding DeleteText}"
                        Style="{StaticResource FlowBlox.WindowActionButton.Delete}"
                        IsDefault="True"
                        Click="Delete_Click" />
            </StackPanel>
        </Border>
    </Grid>
</mah:MetroWindow>
