<Window x:Class="FlowBlox.UICore.Views.SplashWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
    xmlns:texts="clr-namespace:FlowBlox.UICore.Resources"
    Title="FlowBlox" Width="500" Height="180" WindowStartupLocation="CenterScreen"
    WindowStyle="None" ResizeMode="NoResize" AllowsTransparency="True" Background="Transparent"
    ShowInTaskbar="False" Opacity="0.92" Closing="Window_Closing">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="MahAppMetroResources.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>
    <Border CornerRadius="14" Background="#353535" BorderThickness="1" BorderBrush="#6063B9D8" Padding="16">
        <Grid VerticalAlignment="Center">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <!-- Compensate for the GIF's bottom padding to match the visible 8 px text/loader gap. -->
            <Image x:Name="Logo" Width="440" Height="97" HorizontalAlignment="Center" VerticalAlignment="Center"
                   Margin="0,0,0,-10" Stretch="Uniform" AutomationProperties.Name="FlowBlox" />
            <TextBlock Grid.Row="1" Text="{x:Static texts:SplashWindow.Tagline}"
                       FontFamily="Segoe UI" FontSize="12" FontWeight="Normal" Foreground="White"
                       HorizontalAlignment="Center" TextAlignment="Center" Margin="0,0,0,8" />
            <mah:ProgressRing Grid.Row="2" IsActive="True" Width="28" Height="28" Foreground="White" />
        </Grid>
    </Border>
</Window>
