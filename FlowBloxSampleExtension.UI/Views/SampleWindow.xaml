<mah:MetroWindow  
    x:Class="FlowBloxSampleExtension.UI.Views.SampleWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
    xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
    xmlns:viewModel="clr-namespace:FlowBloxSampleExtension.UI.ViewModels"
    xmlns:res="clr-namespace:FlowBloxSampleExtension.UI.Resources"
    Title="{x:Static res:SampleWindow.Title}" 
    Height="340" Width="600"
    mc:Ignorable="d">

    <mah:MetroWindow.DataContext>
        <viewModel:SampleWindowViewModel />
    </mah:MetroWindow.DataContext>

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/FlowBlox.UICore;component/Views/MahAppMetroResources.xaml" />
                <ResourceDictionary Source="/FlowBlox.UICore;component/Views/Styles/FlowBloxCustomStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <DockPanel>
        <StackPanel DockPanel.Dock="Bottom"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="10">
            <Button Click="CancelButton_Click"
                    IsCancel="True"
                    MinWidth="112"
                    Height="32"
                    Padding="12,5"
                    Margin="5">
                <StackPanel Orientation="Horizontal">
                    <iconPacks:PackIconMaterial Kind="ArrowLeft"
                                                Style="{StaticResource FlowBlox.WindowActionIcon.Back}"/>
                    <TextBlock Text="{x:Static res:SampleWindow.Button_Cancel}" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>

            <Button Click="ApplyButton_Click"
                    IsEnabled="{Binding CanCommit}"
                    MinWidth="112"
                    Height="32"
                    Padding="12,5"
                    Margin="5">
                <StackPanel Orientation="Horizontal">
                    <iconPacks:PackIconMaterial Kind="Check"
                                                Style="{StaticResource FlowBlox.WindowActionIcon.Save}"/>
                    <TextBlock Text="{x:Static res:SampleWindow.Button_Apply}" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>

            <Button Click="SaveButton_Click"
                    IsEnabled="{Binding CanCommit}"
                    IsDefault="True"
                    MinWidth="112"
                    Height="32"
                    Padding="12,5"
                    Margin="5">
                <StackPanel Orientation="Horizontal">
                    <iconPacks:PackIconMaterial Kind="ContentSave"
                                                Style="{StaticResource FlowBlox.WindowActionIcon.Save}"/>
                    <TextBlock Text="{x:Static res:SampleWindow.Button_Save}" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
        </StackPanel>

        <Grid Margin="15">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <TextBlock Text="{x:Static res:SampleWindow.Description}"
                       TextWrapping="Wrap"
                       Margin="0,0,0,15"/>

            <TextBlock Grid.Row="1"
                       Text="{x:Static res:SampleWindow.OutputTextLabel}"
                       Margin="0,0,0,5"/>

            <TextBox Grid.Row="2"
                     Text="{Binding OutputText, UpdateSourceTrigger=PropertyChanged}"
                     AcceptsReturn="True"
                     TextWrapping="Wrap"
                     VerticalScrollBarVisibility="Auto"/>
        </Grid>
    </DockPanel>
</mah:MetroWindow>
