          "ReferencedTable": {
            "$id": "26",
            "$type": "FlowBlox.Core.Models.Components.IO.SQLTable, FlowBlox.Core",
            "DbType": "Oracle",
            "SQLConnectionstring": "User Id=$User::Input_OracleUser;Password=$User::Input_OraclePassword;Data Source=//$User::Input_OracleHost:$User::Input_OraclePort/$User::Input_OracleServiceName;",
            "SQLStatement": "SELECT\n    c.COLUMN_NAME AS ColumnName,\n    c.DATA_TYPE AS DataType,\n    c.DATA_TYPE ||\n        CASE\n            WHEN c.CHAR_LENGTH IS NOT NULL AND c.DATA_TYPE LIKE '%CHAR%'\n                THEN '(' || TO_CHAR(c.CHAR_LENGTH) || ')'\n            WHEN c.DATA_PRECISION IS NOT NULL\n                THEN '(' || TO_CHAR(c.DATA_PRECISION) ||\n                    CASE WHEN c.DATA_SCALE IS NOT NULL THEN ',' || TO_CHAR(c.DATA_SCALE) ELSE '' END || ')'\n            ELSE ''\n        END AS TypeSpecification,\n    CASE WHEN c.NULLABLE = 'Y' THEN 'true' ELSE 'false' END AS IsNullable,\n    c.DATA_DEFAULT AS DefaultValue,\n    CASE WHEN EXISTS (\n        SELECT 1\n        FROM USER_CONSTRAINTS uc\n        INNER JOIN USER_CONS_COLUMNS ucc ON ucc.CONSTRAINT_NAME = uc.CONSTRAINT_NAME\n        WHERE uc.CONSTRAINT_TYPE = 'P'\n            AND ucc.TABLE_NAME = c.TABLE_NAME\n            AND ucc.COLUMN_NAME = c.COLUMN_NAME\n    ) THEN 'true' ELSE 'false' END AS IsPrimaryKey,\n    CASE WHEN EXISTS (\n        SELECT 1\n        FROM USER_CONSTRAINTS uc\n        INNER JOIN USER_CONS_COLUMNS ucc ON ucc.CONSTRAINT_NAME = uc.CONSTRAINT_NAME\n        WHERE uc.CONSTRAINT_TYPE IN ('P', 'U')\n            AND ucc.TABLE_NAME = c.TABLE_NAME\n            AND ucc.COLUMN_NAME = c.COLUMN_NAME\n    ) THEN 'true' ELSE 'false' END AS IsUnique,\n    CASE WHEN c.IDENTITY_COLUMN = 'YES' THEN 'true' ELSE 'false' END AS IsAutoIncrement,\n    c.COLUMN_ID AS OrdinalPosition\nFROM USER_TAB_COLUMNS c\nWHERE c.TABLE_NAME = UPPER($User::Input_TableName)\nORDER BY c.COLUMN_ID",
            "Name": "SQLTable_OracleColumns",
            "RequiredFields": {
              "$type": "System.Collections.ObjectModel.ObservableCollection`1[[FlowBlox.Core.Models.Components.FieldElement, FlowBlox.Core]], System.ObjectModel",
