          "ReferencedTable": {
            "$id": "14",
            "$type": "FlowBlox.Core.Models.Components.IO.SQLTable, FlowBlox.Core",
            "DbType": "MSSQL",
            "SQLConnectionstring": "$Decision_MssqlConnectionString::MssqlConnectionString",
            "SQLStatement": "SELECT TABLE_SCHEMA + '.' + TABLE_NAME AS TableName\r\nFROM INFORMATION_SCHEMA.TABLES\r\nWHERE TABLE_TYPE = 'BASE TABLE'\r\nORDER BY TABLE_SCHEMA, TABLE_NAME;",
            "Name": "SQLTable_MssqlTables",
