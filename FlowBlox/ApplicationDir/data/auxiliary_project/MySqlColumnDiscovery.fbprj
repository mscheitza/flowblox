          "ReferencedTable": {
            "$id": "22",
            "$type": "FlowBlox.Core.Models.Components.IO.SQLTable, FlowBlox.Core",
            "DbType": "MySQL",
            "SQLConnectionstring": "Server=localhost;User ID=$User::Input_MySqlUser;Password=$User::Input_MySqlPassword;Database=$User::Input_MySqlDatabase;",
            "SQLStatement": "SELECT\n    c.COLUMN_NAME AS ColumnName,\n    c.DATA_TYPE AS DataType,\n    c.COLUMN_TYPE AS TypeSpecification,\n    CASE WHEN c.IS_NULLABLE = 'YES' THEN 'true' ELSE 'false' END AS IsNullable,\n    c.COLUMN_DEFAULT AS DefaultValue,\n    CASE WHEN c.COLUMN_KEY = 'PRI' THEN 'true' ELSE 'false' END AS IsPrimaryKey,\n    CASE WHEN c.COLUMN_KEY IN ('PRI', 'UNI') THEN 'true' ELSE 'false' END AS IsUnique,\n    CASE WHEN c.EXTRA LIKE '%auto_increment%' THEN 'true' ELSE 'false' END AS IsAutoIncrement,\n    c.ORDINAL_POSITION AS OrdinalPosition\nFROM information_schema.COLUMNS c\nWHERE c.TABLE_SCHEMA = DATABASE()\n    AND c.TABLE_NAME = $User::Input_TableName\nORDER BY c.ORDINAL_POSITION;",
            "Name": "SQLTable_MySqlColumns",
            "RequiredFields": {
              "$type": "System.Collections.ObjectModel.ObservableCollection`1[[FlowBlox.Core.Models.Components.FieldElement, FlowBlox.Core]], System.ObjectModel",
              "$values": [
