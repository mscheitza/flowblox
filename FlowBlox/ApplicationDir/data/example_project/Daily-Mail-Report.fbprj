        "StringValue": "{\n  \"gmail\": {\n    \"address\": \"$User::Input_Gmail_UserName\",\n    \"imap\": {\n      \"host\": \"imap.gmail.com\",\n      \"port\": 993,\n      \"useSsl\": true,\n      \"searchQuery\": \"\",\n      \"maxMails\": 50\n    }\n  },\n  \"mail\": {\n    \"smtp\": {\n      \"host\": \"smtp.gmail.com\",\n      \"port\": 587,\n      \"useSsl\": true\n    },\n    \"fromAddress\": \"$User::Input_Gmail_UserName\",\n    \"toAddress\": \"$User::Input_Gmail_UserName\",\n    \"subjectTemplate\": \"Daily Mail Summary (today)\"\n  },\n  \"openai\": {\n    \"model\": \"gpt-4o-mini\"\n  }\n}",
