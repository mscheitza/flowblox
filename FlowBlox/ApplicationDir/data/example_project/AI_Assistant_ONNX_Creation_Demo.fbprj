        "Source": {
          "$id": "15",
          "$type": "FlowBlox.Core.Models.FlowBlocks.AI.OnnxGenAIFlowBlock, FlowBlox.Core",
          "ModelFolder": "$Options::AI.Onnx.GenAI.ModelRootDirectory\\Phi-4-mini-instruct-onnx",
          "Prompt": "Read the XML invoice below. Populate every field in the required JSON schema, including supplier, customer, and all monetary amounts.\n\nXML:\n$FileReader_InvoiceXml::InvoiceXml",
          "TokenSelectionStrategy": "ArgMax",
          "MaxNewTokens": 500,
          "Temperature": 0.0,
          "TopP": 1.0,
          "TopK": 1,
          "UseChatTemplate": true,
          "SystemPrompt": "Extract invoice values from the supplied XML. Reply with exactly one valid JSON object and nothing else: no Markdown, no code fence, no explanation. You MUST include every key in this exact order, using a string value for each key. If unavailable, use an empty string. Schema: {\"InvoiceNumber\":\"\",\"InvoiceDate\":\"\",\"DueDate\":\"\",\"SupplierName\":\"\",\"SupplierVatId\":\"\",\"CustomerName\":\"\",\"Currency\":\"\",\"NetAmount\":\"\",\"TaxAmount\":\"\",\"GrossAmount\":\"\"}. Copy the best matching values from the XML. Do not omit any key.",
          "ChatTemplate": "<|system|>\n{SystemPrompt}\n<|end|>\n<|user|>\n{UserPrompt}\n<|end|>\n<|assistant|>\n",
          "Name": "OnnxGenAI_InvoiceExtraction",
