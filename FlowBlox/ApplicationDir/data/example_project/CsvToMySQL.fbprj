          "$id": "22",
          "$type": "FlowBlox.Core.Models.FlowBlocks.Persistence.ExecuteSQLFlowBlock, FlowBlox.Core",
          "DbType": "MySQL",
          "SQLConnectionstring": "Server=localhost;Port=3306;Database=SQLDemoDB;Uid=root;Pwd=;",
          "SQLStatement": "INSERT INTO Participants (FirstName, LastName, Language)\r\nSELECT $TableReader_Participants::FirstName, $TableReader_Participants::LastName, $TableReader_Participants::LanguageID\r\nWHERE NOT EXISTS (\r\n    SELECT 1\r\n    FROM Participants\r\n    WHERE FirstName = $TableReader_Participants::FirstName\r\n      AND LastName = $TableReader_Participants::LastName\r\n);",
          "Name": "ExecuteSQL_InsertParticipants",
