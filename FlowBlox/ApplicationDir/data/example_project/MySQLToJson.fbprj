  "ProjectGuid": "6f402617-25c0-40ac-b8ae-7385e68cd2c1",
  "ProjectName": "MySQL to JSON",
  "Author": "",
  "ProjectDescription": "Reads participant and language data from a MySQL database, converts each row into JSON, and writes the resulting participant array to a JSON file in the project's output directory. An included note provides the SQL required to create and seed the sample database.",
