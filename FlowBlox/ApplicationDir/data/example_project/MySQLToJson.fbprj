        "$id": "37",
        "$type": "FlowBlox.Core.Models.FlowBlocks.NoteFlowBlock, FlowBlox.Core",
        "Note": "-- Create the database if it does not exist\r\nCREATE DATABASE IF NOT EXISTS SQLDemoDB;\r\nUSE SQLDemoDB;\r\n\r\n-- Create table: Language\r\nCREATE TABLE IF NOT EXISTS Language (\r\n    ID INT AUTO_INCREMENT PRIMARY KEY,\r\n    Name VARCHAR(100) NOT NULL\r\n);\r\n\r\n-- Create table: Participant\r\nCREATE TABLE IF NOT EXISTS Participant (\r\n    ID INT AUTO_INCREMENT PRIMARY KEY,\r\n    FirstName VARCHAR(100) NOT NULL,\r\n    LastName VARCHAR(100) NOT NULL,\r\n    LanguageID INT,\r\n    CONSTRAINT FK_Participant_Language FOREIGN KEY (LanguageID) REFERENCES Language(ID)\r\n);\r\n\r\n-- Insert test languages\r\nINSERT INTO Language (Name) VALUES ('German'), ('English');\r\n\r\n-- Insert test participants\r\nINSERT INTO Participant (FirstName, LastName, LanguageID) VALUES\r\n('John',  'Miller',   1), -- German\r\n('Sarah', 'Smith',    2), -- English\r\n('Peter', 'Schneider',1); -- German\r\n",
