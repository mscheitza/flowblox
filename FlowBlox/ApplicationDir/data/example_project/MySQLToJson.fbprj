            "SQLStatement": "SELECT \r\n    p.ID AS ParticipantID,\r\n    p.FirstName,\r\n    p.LastName,\r\n    l.Name AS Language\r\nFROM Participant p\r\nLEFT JOIN Language l ON p.LanguageID = l.ID;",
