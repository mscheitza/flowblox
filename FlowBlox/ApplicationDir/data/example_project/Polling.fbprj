  "ProjectGuid": "2cb36e59-9a4b-400a-a786-263324defc5d",
  "ProjectName": "Polling",
  "Author": "",
  "ProjectDescription": "Simulates polling a job queue through empty, pending, and successful states using sample JSON data. It checks for a successful job, repeats the flow after a delay while none is available, and creates a semaphore file when a job succeeds.",
