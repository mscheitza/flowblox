        "Source": {
          "$id": "4",
          "$type": "FlowBlox.Core.Models.FlowBlocks.TextOperations.FormatFlowBlock, FlowBlox.Core",
          "FieldName": null,
          "AllowEmptyFormatExpression": false,
          "FormatExpression": "<!DOCTYPE html>\r\n<html lang=\"en\">\r\n<head>\r\n    <meta charset=\"UTF-8\">\r\n    <title>Participant Data</title>\r\n</head>\r\n<body>\r\n\r\n<h2>Participant Data</h2>\r\n\r\n<form>\r\n    <label>Last name:</label>\r\n    <input type=\"text\" name=\"lastName\" value=\"Smith\">\r\n    <br><br>\r\n\r\n    <label>First name:</label>\r\n    <input type=\"text\" name=\"firstName\" value=\"Alex\">\r\n    <br><br>\r\n\r\n    <label>Date of birth:</label>\r\n    <input type=\"date\" name=\"dateOfBirth\" value=\"1990-05-15\">\r\n    <br><br>\r\n\r\n    <label>Place of birth:</label>\r\n    <input type=\"text\" name=\"placeOfBirth\" value=\"Manchester\">\r\n    <br><br>\r\n\r\n    <label>Gender:</label>\r\n    <select name=\"gender\">\r\n        <option>male</option>\r\n        <option>female</option>\r\n        <option>non-binary</option>\r\n    </select>\r\n    <br><br>\r\n\r\n    <label>Nationality:</label>\r\n    <input type=\"text\" name=\"nationality\" value=\"British\">\r\n    <br><br>\r\n\r\n    <label>Street and house number:</label>\r\n    <input type=\"text\" name=\"streetAddress\" value=\"12 Example Street\">\r\n    <br><br>\r\n\r\n    <label>Postal code:</label>\r\n    <input type=\"text\" name=\"postalCode\" value=\"SW1A 1AA\">\r\n    <br><br>\r\n\r\n    <label>City:</label>\r\n    <input type=\"text\" name=\"city\" value=\"London\">\r\n    <br><br>\r\n\r\n    <label>Email:</label>\r\n    <input type=\"email\" name=\"email\" value=\"alex.smith@example.com\">\r\n    <br><br>\r\n\r\n    <label>Phone number:</label>\r\n    <input type=\"tel\" name=\"phoneNumber\" value=\"+44 20 7946 0958\">\r\n    <br><br>\r\n\r\n    <button type=\"submit\">Save</button>\r\n</form>\r\n\r\n</body>\r\n</html>",
          "FormatParameterDefinitions": {
            "$type": "System.Collections.ObjectModel.ObservableCollection`1[[FlowBlox.Core.Models.FlowBlocks.Format.FormatParameterDefinition, FlowBlox.Core]], System.ObjectModel",
